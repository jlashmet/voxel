    "^Assets/.*WorldBuilder",
    "^Assets/.*Streaming",
    "^Assets/.*Runtime/",
    "^Assets/.*Public/",
    "^Packages/",
    "^ProjectSettings/",
    "^tools/(?:module-validation|run-module-validation|select-tests)",
    "^\\.github/workflows/"

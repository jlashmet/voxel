{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewedMasterSha",
    "reviewedItems",
    "followups",
    "unresolvedQuestions"
  ],
  "properties": {
    "reviewedMasterSha": {
      "type": "string",
      "minLength": 1
    },
    "reviewedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "result", "note"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "accepted",
              "follow-up-created",
              "deferred",
              "needs-deeper-review"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "followups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "originIssue",
          "originSha",
          "evidence",
          "problem",
          "impact",
          "expectedBehavior",
          "acceptanceCriteria",
          "relevantPaths"
        ],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "originIssue": {"type": "string"},
          "originSha": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1},
          "problem": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "expectedBehavior": {"type": "string", "minLength": 1},
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "relevantPaths": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}

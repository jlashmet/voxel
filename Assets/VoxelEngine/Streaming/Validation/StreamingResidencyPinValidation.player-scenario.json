{
  "schemaVersion": 1,
  "runSeconds": 10,
  "capture": { "width": 1280, "height": 720, "intervalSeconds": 2, "minimumFrames": 2, "evidenceAfterSeconds": 1 },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "STREAMING_PIN_VALIDATION pinned: ready=true evicted=0 resident=true",
      "STREAMING_PIN_VALIDATION released: evicted=1 resident=false"
    ],
    "forbiddenLogPatterns": ["STREAMING_PIN_VALIDATION failure:", "NullReferenceException", "MissingReferenceException"]
  }
}

#pragma kernel CSSampleDensity
#pragma kernel CSBatchSampleDensity
#pragma kernel CSCountCells
#pragma kernel CSBatchCountCells
#pragma kernel CSCountFacetedFaces
#pragma kernel CSBatchCountFacetedFaces
#pragma kernel CSCountDecorations
#pragma kernel CSBatchCountDecorations
#pragma kernel CSBatchSampleFaces
#pragma kernel CSBatchCountTransitions
#pragma kernel CSBatchCountProfiles
#pragma kernel CSBatchWriteTransitions
#pragma kernel CSBatchWriteProfiles
#pragma kernel CSBatchPublishArgs
#pragma kernel CSWriteCells
#pragma kernel CSBatchWriteCells
#pragma kernel CSWriteFacetedFaces
#pragma kernel CSBatchWriteFacetedFaces
#pragma kernel CSWriteDecorations
#pragma kernel CSBatchWriteDecorations
#pragma kernel CSCopyVertices
#pragma kernel CSCopyIndices
#pragma kernel CSPublishArgs
#pragma kernel CSCopyCountersToBatch
#pragma kernel CSPrefixBatchCounts
#pragma kernel CSSampleFace
#pragma kernel CSTransitionCells

// Preserve the entire production mesher while replacing only the two sampling function bodies.
// Included pragma declarations are not exported by Unity, so this wrapper declares the production
// kernel surface explicitly before including the unchanged mesher implementation.
#define CSSampleDensity CSSampleDensityInlineBroken
#define CSBatchSampleDensity CSBatchSampleDensityInlineBroken
#include "../../Resources/VoxelBrickMesher.compute"
#undef CSSampleDensity
#undef CSBatchSampleDensity

[numthreads(64, 1, 1)]
void CSSampleDensity(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    int total = _GridSize * _GridSize * _GridSize;
    if (index >= total) return;

    int gx = index % _GridSize;
    int yz = index / _GridSize;
    int gy = yz % _GridSize;
    int gz = yz / _GridSize;
    int3 p = _ChunkOriginVoxel + (int3(gx, gy, gz) - _Padding) * _SourceStep;

    uint material, surface, boundary;
    float density = SampleField(p, _SourceStep, material, surface, boundary);
    _DensityWrite[index] = density;
    _SampleMaterialWrite[index] = material;
    _SampleSurfaceWrite[index] = surface;
    _SampleBoundaryWrite[index] = boundary;
}

[numthreads(64, 1, 1)]
void CSBatchSampleDensity(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    int total = BatchSampleCount();
    if (index >= total) return;
    BatchChunkDescriptor chunk = _BatchChunks[id.y];
    int gx = index % _GridSize;
    int yz = index / _GridSize;
    int gy = yz % _GridSize;
    int gz = yz / _GridSize;
    int3 p = chunk.chunkOriginVoxel
           + (int3(gx, gy, gz) - _Padding) * chunk.sourceStep;

    uint material, surface, boundary;
    int output = (int)id.y * total + index;
    float density = SampleField(p, chunk.sourceStep, material, surface, boundary);
    _BatchDensityWrite[output] = density;
    _BatchSampleMaterialWrite[output] = material;
    _BatchSampleSurfaceWrite[output] = surface;
    _BatchSampleBoundaryWrite[output] = boundary;
}

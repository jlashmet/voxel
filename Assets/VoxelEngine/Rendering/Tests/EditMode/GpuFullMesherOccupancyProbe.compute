#pragma kernel CSProbeFullMesherOccupancy
#pragma kernel CSProbeDispatchCoordinate
#pragma kernel CSProbeInlineSampleAssignment

// Compile the complete production mesher into this test shader so Metal sees the same helper graph,
// declarations, and code-generation context. The added kernels are diagnostic only; they do not
// duplicate extraction or change production behavior.
#include "../../Resources/VoxelBrickMesher.compute"

RWStructuredBuffer<uint> _ProbeWords;
RWStructuredBuffer<float> _ProbeFloats;

[numthreads(1, 1, 1)]
void CSProbeFullMesherOccupancy(uint3 id : SV_DispatchThreadID)
{
    const int3 p = int3(-2, -2, -2);

    uint rawSurface, rawBoundary;
    uint rawMaterial = ReadMaterial(p, rawSurface, rawBoundary);
    bool directSolid = IsSolidSample(rawMaterial);
    uint resolvedSurface = ResolveSurface(rawMaterial, rawSurface);

    uint sampledMaterial, sampledSurface, sampledBoundary;
    float density = SampleField(p, 1, sampledMaterial, sampledSurface, sampledBoundary);

    _ProbeWords[0] = rawMaterial;
    _ProbeWords[1] = rawSurface;
    _ProbeWords[2] = rawBoundary;
    _ProbeWords[3] = directSolid ? 1u : 0u;
    _ProbeWords[4] = resolvedSurface;
    _ProbeWords[5] = sampledMaterial;
    _ProbeWords[6] = sampledSurface;
    _ProbeWords[7] = sampledBoundary;
    _ProbeWords[8] = _SolidWaterMaterialMask;
    _ProbeFloats[0] = density;
}

[numthreads(64, 1, 1)]
void CSProbeDispatchCoordinate(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0u) return;

    int index = (int)id.x;
    int gx = index % _GridSize;
    int yz = index / _GridSize;
    int gy = yz % _GridSize;
    int gz = yz / _GridSize;
    int3 p = _ChunkOriginVoxel + (int3(gx, gy, gz) - _Padding) * _SourceStep;
    int3 worldBrick = WorldBrickOf(p);
    int3 localBrick = worldBrick - _BrickCacheOrigin;
    int brickIndex = localBrick.x
                   + _BrickCacheEdge * (localBrick.y + _BrickCacheEdge * localBrick.z);

    uint rawSurface, rawBoundary;
    uint rawMaterial = ReadMaterial(p, rawSurface, rawBoundary);
    bool directSolid = IsSolidSample(rawMaterial);
    uint sampledMaterial, sampledSurface, sampledBoundary;
    float density = SampleField(p, _SourceStep, sampledMaterial, sampledSurface, sampledBoundary);

    _ProbeWords[0] = asuint(p.x);
    _ProbeWords[1] = asuint(p.y);
    _ProbeWords[2] = asuint(p.z);
    _ProbeWords[3] = rawMaterial;
    _ProbeWords[4] = directSolid ? 1u : 0u;
    _ProbeWords[5] = sampledMaterial;
    _ProbeWords[6] = sampledSurface;
    _ProbeWords[7] = sampledBoundary;
    _ProbeWords[8] = _SolidWaterMaterialMask;
    _ProbeWords[9] = asuint(_BrickCacheOrigin.x);
    _ProbeWords[10] = asuint(_BrickCacheOrigin.y);
    _ProbeWords[11] = asuint(_BrickCacheOrigin.z);
    _ProbeWords[12] = asuint(_BrickCacheEdge);
    _ProbeWords[13] = _BrickCache[0];
    _ProbeWords[14] = asuint(localBrick.y);
    _ProbeWords[15] = asuint(brickIndex);
    _ProbeFloats[0] = density;
}

// Exact expression shape used by production CSSampleDensity: SampleField's return value is written
// directly to a UAV while three uninitialized locals are passed as out parameters, then those locals
// are written to their UAVs. The split-local probe above is the control case.
[numthreads(64, 1, 1)]
void CSProbeInlineSampleAssignment(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0u) return;

    int index = (int)id.x;
    int gx = index % _GridSize;
    int yz = index / _GridSize;
    int gy = yz % _GridSize;
    int gz = yz / _GridSize;
    int3 p = _ChunkOriginVoxel + (int3(gx, gy, gz) - _Padding) * _SourceStep;

    uint material, surface, boundary;
    _DensityWrite[index] = SampleField(p, _SourceStep, material, surface, boundary);
    _SampleMaterialWrite[index] = material;
    _SampleSurfaceWrite[index] = surface;
    _SampleBoundaryWrite[index] = boundary;
}

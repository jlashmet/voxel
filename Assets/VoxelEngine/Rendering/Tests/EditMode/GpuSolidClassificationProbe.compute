#pragma kernel CSProbe

#include "../../Resources/VoxelBrickDensity.hlsl"

RWStructuredBuffer<uint> _ProbeOutput;

[numthreads(1, 1, 1)]
void CSProbe(uint3 id : SV_DispatchThreadID)
{
    const uint material = 1u;
    _ProbeOutput[0] = IsSolidSample(material) ? 1u : 0u;
    _ProbeOutput[1] = _SolidWaterMaterialMask;
}

{
  "schemaVersion": 1,
  "runSeconds": 30,
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 10,
    "minimumFrames": 2
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "WATER_VALIDATION ready:",
      "WATER_VALIDATION liquid-ready:"
    ],
    "forbiddenLogPatterns": [
      "WATER_VALIDATION liquid renderer did not converge:",
      "NullReferenceException",
      "MissingReferenceException",
      "Shader error"
    ]
  }
}

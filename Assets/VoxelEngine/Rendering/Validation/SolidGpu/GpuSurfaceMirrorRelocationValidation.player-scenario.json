{
  "schemaVersion": 1,
  "runSeconds": 65,
  "gpuCutover": "required",
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 10,
    "minimumFrames": 6,
    "evidenceAfterSeconds": 2
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "GPU_MIRROR_RELOCATION initial-ready:",
      "GPU_MIRROR_RELOCATION relocated:",
      "GPU_MIRROR_RELOCATION success:"
    ],
    "forbiddenLogPatterns": [
      "GPU_MIRROR_RELOCATION failure:",
      "Exception",
      "Shader error",
      "GPU surface transaction rejected"
    ]
  }
}

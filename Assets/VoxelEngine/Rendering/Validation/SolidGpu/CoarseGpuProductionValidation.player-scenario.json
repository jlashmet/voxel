{
  "schemaVersion": 1,
  "runSeconds": 60,
  "gpuCutover": "required",
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 10,
    "minimumFrames": 5,
    "evidenceAfterSeconds": 2
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "COARSE_GPU success:",
      "COARSE_GPU step4-ready:"
    ],
    "forbiddenLogPatterns": [
      "COARSE_GPU failure:",
      "Exception",
      "Shader error",
      "GPU surface transaction rejected"
    ]
  }
}

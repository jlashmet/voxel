#pragma kernel CSBrickRaymarch

// Brickmap raymarch.
//
// One ray per pixel, marched with a DDA over brick coordinates. Empty and uniform bricks are
// resolved from the pointer alone — no voxel memory is touched — so open sky and solid rock are
// both nearly free to traverse. Only a mixed brick descends into a second DDA over its 8^3
// voxels. That two-tier structure is the whole point of the brickmap: cost tracks surfaces, not
// volume.
//
// Nothing here produces authoritative state. Float arithmetic is fine on this side of the line;
// the integer CPU jobs own agreement (Constitution Principle I).

// Window of region slots around the camera. Each entry is a slot index or -1.
StructuredBuffer<int> g_RegionWindow;

// Brick pointers, MaxSlots * 262144 entries. Negative values encode uniform material as
// -(material + 1), so -1 is empty. Non-negative values are brick pool indices.
StructuredBuffer<int> g_BrickRefs;

// Voxel bytes of the brick pool, four materials per uint.
StructuredBuffer<uint> g_BrickVoxels;

RWTexture2D<float4> g_Colour;

Texture2D<float4> g_StoneTexture;
Texture2D<float4> g_WoodTexture;
Texture2D<float4> g_SandTexture;
Texture2D<float4> g_RockTexture;
Texture2D<float4> g_SlateTexture;
Texture2D<float4> g_GrassTexture;
Texture2D<float4> g_DirtTexture;
Texture2D<float4> g_DarkStoneTexture;
Texture2D<float4> g_StoneNormal;
Texture2D<float4> g_WoodNormal;
Texture2D<float4> g_SandNormal;
Texture2D<float4> g_RockNormal;
Texture2D<float4> g_SlateNormal;
Texture2D<float4> g_GrassNormal;
Texture2D<float4> g_DirtNormal;
Texture2D<float4> g_DarkStoneNormal;
Texture2D<float4> g_SkyTexture;
SamplerState sampler_g_StoneTexture;

float4x4 g_InvViewProj;
float3   g_CameraPos;        // world space, metres
float3   g_WindowOrigin;     // region coordinate of window cell (0,0,0)
float3   g_SunDirection;     // normalised, pointing from surface toward the sun
float4   g_SkyHorizon;
float4   g_SkyZenith;
float2   g_TargetSize;       // width, height in pixels
float    g_VoxelSize;        // metres per voxel
float    g_MaxDistance;      // metres
uint     g_MaxSteps;         // brick steps per ray (device-matrix.md: 256 on PC)
uint     g_WindowX;
uint     g_WindowY;
uint     g_WindowZ;

// 0 = shade normally. Non-zero modes emit traversal state instead of colour, so a failure
// can be located in one frame rather than inferred from what the picture looks like.
uint     g_DebugMode;

// -- implicit far field -------------------------------------------------------
// Beyond the resident set there are no voxels to march, so distance cannot come from
// residency: a 10 km horizon at full detail is hundreds of regions and gigabytes. The far
// field is evaluated from the world seed instead and costs nothing to keep resident, which is
// what device-matrix.md means by "implicit far-field (mip 5+)". This is the demo's terrain
// function ported exactly, so the procedural horizon lines up with the voxels in front of it.
uint     g_TerrainSeed;
float    g_FarDistance;      // metres; 0 disables the far field
uint     g_FarBaseHeight;    // voxels
uint     g_FarEnabled;

// Presentation-only section box. Voxels inside it are skipped by primary, shadow, and AO rays;
// CPU storage remains untouched and therefore stays authoritative.
uint     g_CutawayEnabled;
float3   g_CutawayMinVoxel;
float3   g_CutawayMaxVoxel;

// Material colours, indexed by material id. Slot 0 is empty and never shaded.
float4 g_MaterialColours[16];
uint g_LocalLightCount;
float4 g_LocalLights[20];          // xyz position in metres, w radius
float4 g_LocalLightColours[20];    // rgb tint, w intensity
uint g_FlashlightEnabled;
float3 g_FlashlightPosition;
float3 g_FlashlightDirection;
float4 g_FlashlightColour;         // rgb linear tint, w intensity
float g_FlashlightRange;
float g_FlashlightInnerCos;
float g_FlashlightOuterCos;

static const int k_BrickEdge = 8;
static const int k_RegionEdgeLog2 = 6;      // bricks per region edge = 64
static const int k_RegionEdgeMask = 63;
static const int k_BricksPerRegion = 64 * 64 * 64;

// -- storage lookups ----------------------------------------------------------

int RegionSlot(int3 regionCoord)
{
    // Single exit: some compilers warn about multi-return helpers being potentially
    // uninitialised, and an undefined slot index would read arbitrary brick memory.
    int slot = -1;
    int3 w = regionCoord - int3(g_WindowOrigin);

    bool inside = w.x >= 0 && w.y >= 0 && w.z >= 0
               && w.x < (int)g_WindowX && w.y < (int)g_WindowY && w.z < (int)g_WindowZ;

    if (inside)
        slot = g_RegionWindow[w.x + (int)g_WindowX * (w.y + (int)g_WindowY * w.z)];

    return slot;
}

// Brick reference at a brick coordinate, or -1 (empty) when the region is not resident. A
// non-resident region reading as empty is the same contract the CPU side uses.
int BrickRefAt(int3 brickCoord)
{
    int result = -1;
    int slot = RegionSlot(brickCoord >> k_RegionEdgeLog2);

    if (slot >= 0)
    {
        int3 b = brickCoord & k_RegionEdgeMask;
        int indexInRegion = b.x | (b.y << k_RegionEdgeLog2) | (b.z << (k_RegionEdgeLog2 * 2));
        result = g_BrickRefs[slot * k_BricksPerRegion + indexInRegion];
    }

    return result;
}

uint VoxelMaterial(int poolIndex, int3 v)
{
    int voxelIndex = v.x | (v.y << 3) | (v.z << 6);          // matches OccupancyMask.VoxelIndex
    uint packed = g_BrickVoxels[poolIndex * 128 + (voxelIndex >> 2)];
    return (packed >> ((voxelIndex & 3) * 8)) & 0xFFu;
}

bool PresentationClipped(int3 voxel)
{
    if (g_CutawayEnabled == 0u) return false;

    float3 p = float3(voxel);
    return all(p >= g_CutawayMinVoxel) && all(p < g_CutawayMaxVoxel);
}

// Material at an arbitrary voxel. Keeping this lookup separate from SolidAt lets presentation
// shading distinguish terrain caps from foliage without changing traversal or authoritative
// occupancy.
uint MaterialAt(int3 voxel)
{
    if (PresentationClipped(voxel)) return 0u;

    int3 brick = voxel >> 3;
    int brickRef = BrickRefAt(brick);

    if (brickRef == -1) return 0u;
    if (brickRef < -1) return (uint)(-brickRef - 1);

    return VoxelMaterial(brickRef, voxel & 7);
}

// True when a voxel is solid. Used by the shadow and occlusion rays, which need to sample the
// world at arbitrary points rather than walk it.
bool SolidAt(int3 voxel)
{
    return MaterialAt(voxel) != 0u;
}

// Implemented in the implicit-far-field section below. HLSL permits a forward declaration;
// keeping the canonical function single-sourced prevents near shading and the horizon drifting.
int FarSurfaceHeight(int wx, int wz);

bool NaturalTerrainCap(uint material, int3 voxel)
{
    if (material != 3u && material != 10u) return false;

    // Procedural terrain writes its cap at this exact canonical height. Trees, roofs, courtyard
    // planting, and the raised castle crag do not, so they retain their authored voxel normals.
    return abs(voxel.y - FarSurfaceHeight(voxel.x, voxel.z)) <= 1;
}

float3 SmoothNaturalTerrainNormal(int3 voxel)
{
    const int radius = 4;
    int hL = FarSurfaceHeight(voxel.x - radius, voxel.z);
    int hR = FarSurfaceHeight(voxel.x + radius, voxel.z);
    int hD = FarSurfaceHeight(voxel.x, voxel.z - radius);
    int hU = FarSurfaceHeight(voxel.x, voxel.z + radius);
    return normalize(float3((float)(hL - hR), radius * 2.0,
                            (float)(hD - hU)));
}

// Bevels lighting across exposed voxel edges while preserving the authoritative grid and exact
// ray hit. Neighbour checks are essential: without them every voxel inside a flat wall rounds
// independently and the wall looks quilted. Only an edge with empty space beside it contributes
// a tangent normal, producing the soft masonry/wood silhouette of a high-resolution voxel model
// without changing collision, storage, or destruction topology.
float3 RoundedSurfaceNormal(float3 hitVoxel, float3 faceNormal)
{
    const float bevel = 0.24;
    const float strength = 0.82;

    int3 solidVoxel = int3(floor(hitVoxel - faceNormal * 0.02));
    float3 f = frac(hitVoxel);
    float3 n = faceNormal;

    if (abs(faceNormal.x) > 0.5)
    {
        if (!SolidAt(solidVoxel + int3(0, -1, 0)))
            n.y -= strength * (1.0 - smoothstep(0.0, bevel, f.y));
        if (!SolidAt(solidVoxel + int3(0, 1, 0)))
            n.y += strength * smoothstep(1.0 - bevel, 1.0, f.y);
        if (!SolidAt(solidVoxel + int3(0, 0, -1)))
            n.z -= strength * (1.0 - smoothstep(0.0, bevel, f.z));
        if (!SolidAt(solidVoxel + int3(0, 0, 1)))
            n.z += strength * smoothstep(1.0 - bevel, 1.0, f.z);
    }
    else if (abs(faceNormal.y) > 0.5)
    {
        if (!SolidAt(solidVoxel + int3(-1, 0, 0)))
            n.x -= strength * (1.0 - smoothstep(0.0, bevel, f.x));
        if (!SolidAt(solidVoxel + int3(1, 0, 0)))
            n.x += strength * smoothstep(1.0 - bevel, 1.0, f.x);
        if (!SolidAt(solidVoxel + int3(0, 0, -1)))
            n.z -= strength * (1.0 - smoothstep(0.0, bevel, f.z));
        if (!SolidAt(solidVoxel + int3(0, 0, 1)))
            n.z += strength * smoothstep(1.0 - bevel, 1.0, f.z);
    }
    else
    {
        if (!SolidAt(solidVoxel + int3(-1, 0, 0)))
            n.x -= strength * (1.0 - smoothstep(0.0, bevel, f.x));
        if (!SolidAt(solidVoxel + int3(1, 0, 0)))
            n.x += strength * smoothstep(1.0 - bevel, 1.0, f.x);
        if (!SolidAt(solidVoxel + int3(0, -1, 0)))
            n.y -= strength * (1.0 - smoothstep(0.0, bevel, f.y));
        if (!SolidAt(solidVoxel + int3(0, 1, 0)))
            n.y += strength * smoothstep(1.0 - bevel, 1.0, f.y);
    }

    return normalize(n);
}

// Estimates the normal of the authored solid volume rather than the single voxel face struck by
// the ray. A tower cylinder is necessarily a staircase in storage; lighting every stair with its
// axis-aligned hit normal turns that high-resolution curve into alternating black vertical bands.
// Central occupancy differences across a wider stencil recover the larger masonry form while retaining
// crisp silhouettes, exact ray hits, collision, and destruction topology.
float3 MasonryVolumeNormal(int3 voxel, float3 faceNormal)
{
    const int radius = 3;
    float3 gradient;
    gradient.x = (SolidAt(voxel - int3(radius, 0, 0)) ? 1.0 : 0.0)
               - (SolidAt(voxel + int3(radius, 0, 0)) ? 1.0 : 0.0);
    gradient.y = (SolidAt(voxel - int3(0, radius, 0)) ? 1.0 : 0.0)
               - (SolidAt(voxel + int3(0, radius, 0)) ? 1.0 : 0.0);
    gradient.z = (SolidAt(voxel - int3(0, 0, radius)) ? 1.0 : 0.0)
               - (SolidAt(voxel + int3(0, 0, radius)) ? 1.0 : 0.0);

    // Thin trim can be solid on both sides of every wide probe. The struck face remains the
    // reliable fallback and also keeps the inferred normal in the visible hemisphere.
    if (dot(gradient, gradient) < 0.0001) return faceNormal;
    float3 inferred = normalize(gradient + faceNormal * 0.22);
    if (dot(inferred, faceNormal) < 0.12)
        inferred = normalize(inferred + faceNormal * 0.55);
    return inferred;
}

// Marches toward the sun and reports whether anything blocks it.
//
// A raymarcher gets shadows almost free — it is the same traversal, run again, and stopping at
// the first hit rather than shading it. Without them every surface at the same orientation reads
// identically no matter what is in front of it, which is most of why the castle looked flat.
float SunShadow(float3 startVoxel, float3 normal)
{
    float3 p = startVoxel + normal * 1.5 + g_SunDirection * 1.5;

    // Long steps: a shadow only needs to know whether something is in the way, and a stride under
    // a voxel would cost hundreds of samples to clear a tower.
    [loop]
    for (uint i = 0u; i < 48u; i++)
    {
        if (SolidAt(int3(floor(p)))) return 0.0;
        p += g_SunDirection * (1.6 + i * 0.35);
    }

    return 1.0;
}

// Ambient occlusion by sampling the neighbourhood of the hit.
//
// Voxel scenes live or die on this. Every inside corner, every joint between wall and ground,
// every window reveal needs to darken, and with flat colour and no occlusion the whole thing
// reads as printed cardboard.
float Occlusion(float3 hitVoxel, float3 normal)
{
    float occluded = 0.0;
    float total = 0.0;

    // Two shells: near samples catch creases, far samples catch the larger cavities like a gate
    // passage or a courtyard corner.
    [unroll]
    for (int shell = 1; shell <= 2; shell++)
    {
        float radius = shell * 2.5;

        [unroll]
        for (int s = 0; s < 6; s++)
        {
            // A fixed spread around the normal. Deterministic sample directions rather than
            // random ones, so successive frames do not shimmer.
            float3 offsets[6] =
            {
                float3( 1,  1,  0), float3(-1,  1,  0), float3( 0,  1,  1),
                float3( 0,  1, -1), float3( 1,  0,  1), float3(-1,  0, -1)
            };

            float3 dir = normalize(normal * 1.6 + offsets[s]);
            float3 p = hitVoxel + normal * 0.75 + dir * radius;

            occluded += SolidAt(int3(floor(p))) ? 1.0 : 0.0;
            total += 1.0;
        }
    }

    // Never fully black: a corner in daylight is dark, not absent.
    return lerp(1.0, 0.24, occluded / total);
}

float3 SkyColour(float3 dir)
{
    float t = saturate(dir.y * 0.5 + 0.5);
    return lerp(g_SkyHorizon.rgb, g_SkyZenith.rgb, t);
}

float3 PresentationSky(float3 dir)
{
    // Equirectangular authored panorama. Keeping this in the same compute pass as the opaque
    // landscape guarantees that its colour and the aerial-perspective target are identical.
    float2 skyUv = float2(atan2(dir.x, dir.z) * 0.159154943 + 0.5,
                          asin(clamp(dir.y, -1.0, 1.0)) * 0.318309886 + 0.5);
    float3 paintedSky = g_SkyTexture.SampleLevel(sampler_g_StoneTexture, skyUv, 0.0).rgb;
    float paintedLuminance = dot(paintedSky, float3(0.2126, 0.7152, 0.0722));
    paintedSky = lerp(paintedLuminance.xxx, paintedSky, 0.46);
    float3 sky = lerp(paintedSky, SkyColour(dir), 0.48);

    // The direct sun is behind the player in the hero approach, but its broad warm halo still
    // gives the upper sky a lighting direction and matches the warm/cool split used indoors.
    float towardSun = saturate(dot(dir, g_SunDirection));
    float glow = pow(towardSun, 18.0) * 0.30;
    float disc = pow(towardSun, 850.0) * 2.2;
    sky += float3(1.0, 0.55, 0.22) * glow + float3(1.0, 0.91, 0.72) * disc;

    return sky;
}

uint FarHash(uint v)
{
    v ^= v >> 16; v *= 0x85ebca6bu;
    v ^= v >> 13; v *= 0xc2b2ae35u;
    v ^= v >> 16;
    return v;
}

float2 SurfaceUV(float3 normal, float3 hitVoxel)
{
    float3 a = abs(normal);
    if (a.y >= a.x && a.y >= a.z) return hitVoxel.xz / 36.0;
    if (a.x >= a.z) return hitVoxel.zy / 36.0;
    return hitVoxel.xy / 36.0;
}

float3 SampleSurfaceTexture(uint material, float2 uv, float3 hitVoxel,
                            float hitDistance, float3 fallback, float lod)
{
    float3 texel = fallback;

    if (material == 1u) texel = g_StoneTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 2u) texel = g_WoodTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 3u) texel = g_SandTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 6u)
    {
        float exteriorWeathering = smoothstep(110.0, 170.0, hitVoxel.y)
                                 * (1.0 - smoothstep(120.0, 220.0, hitDistance));
        float3 caveRock = g_RockTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
        float3 agedMasonry = g_DarkStoneTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
        texel = lerp(caveRock, agedMasonry, exteriorWeathering);
    }
    else if (material == 7u) texel = g_SlateTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 8u)
        texel = g_SlateTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb
              * float3(1.18, 0.68, 0.58);
    else if (material == 10u) texel = g_GrassTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 13u) texel = g_DirtTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 14u)
        texel = g_GrassTexture.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb * 0.72;

    return texel;
}

float3 SampleSurfaceNormal(uint material, float2 uv, float3 hitVoxel,
                           float hitDistance, float3 surfaceNormal, float lod)
{
    float3 packed = float3(0.5, 0.5, 1.0);
    bool mapped = true;

    if (material == 1u) packed = g_StoneNormal.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 2u) packed = g_WoodNormal.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 3u) packed = g_SandNormal.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 6u)
    {
        float exteriorWeathering = smoothstep(110.0, 170.0, hitVoxel.y)
                                 * (1.0 - smoothstep(120.0, 220.0, hitDistance));
        float3 caveNormal = g_RockNormal.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
        float3 masonryNormal = g_DarkStoneNormal.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
        packed = lerp(caveNormal, masonryNormal, exteriorWeathering);
    }
    else if (material == 7u || material == 8u)
        packed = g_SlateNormal.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 10u || material == 14u)
        packed = g_GrassNormal.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else if (material == 13u)
        packed = g_DirtNormal.SampleLevel(sampler_g_StoneTexture, uv, lod).rgb;
    else mapped = false;

    if (!mapped) return surfaceNormal;

    float3 tangentNormal = normalize(packed * 2.0 - 1.0);
    float3 a = abs(surfaceNormal);
    float3 tangent;
    float3 bitangent;
    if (a.y >= a.x && a.y >= a.z)
    {
        tangent = float3(1, 0, 0);
        bitangent = float3(0, 0, 1);
    }
    else if (a.x >= a.z)
    {
        tangent = float3(0, 0, 1);
        bitangent = float3(0, 1, 0);
    }
    else
    {
        tangent = float3(1, 0, 0);
        bitangent = float3(0, 1, 0);
    }

    return normalize(surfaceNormal * max(tangentNormal.z, 0.18)
                   + tangent * tangentNormal.x + bitangent * tangentNormal.y);
}

float3 Shade(uint material, float3 normal, float3 hitVoxel)
{
    float hitDistance = length(hitVoxel * g_VoxelSize - g_CameraPos);
    float3 faceNormal = normal;
    bool masonryCandidate = material == 1u || material == 6u;
    // Masonry gets a larger-scale volume normal below. Avoid paying four edge-neighbour probes
    // for a bevel that would immediately be replaced, particularly in full-screen castle views.
    float3 roundedNormal = masonryCandidate ? faceNormal
                                            : RoundedSurfaceNormal(hitVoxel, normal);
    // A ten-centimetre bevel is sub-pixel in a long shot. Applying it anyway turns every
    // one-voxel terrain terrace into alternating light/dark stipple, so fade to the stable face
    // normal before the edge becomes smaller than a pixel.
    float bevelVisibility = 1.0 - smoothstep(24.0, 52.0, hitDistance);
    normal = normalize(lerp(normal, roundedNormal, bevelVisibility));

    int3 solidVoxel = int3(floor(hitVoxel - faceNormal * 0.02));
    int3 terrainVoxel = solidVoxel;

    // A quantised slope exposes the mineral voxel immediately beneath each grass/sand cap as a
    // field of gray side-face flecks. Treat only that one canonical under-edge as the cap for
    // presentation. Storage, destruction hardness, ray hits, and collision remain stone.
    if (material == 1u)
    {
        [unroll]
        for (int capOffset = 1; capOffset <= 3; capOffset++)
        {
            int3 capVoxel = solidVoxel + int3(0, capOffset, 0);
            uint capMaterial = MaterialAt(capVoxel);
            if (NaturalTerrainCap(capMaterial, capVoxel))
            {
                material = capMaterial;
                terrainVoxel = capVoxel;
                break;
            }

            // Empty space means this is a structural surface, not a buried terrain edge. Stop
            // before sampling farther above a wall or ruin.
            if (capMaterial == 0u) break;
        }
    }

    bool naturalTerrainSurface = NaturalTerrainCap(material, terrainVoxel);
    if (naturalTerrainSurface)
    {
        float3 terrainNormal = SmoothNaturalTerrainNormal(terrainVoxel);
        // Preserve a hint of the close voxel face for material readability, then converge to the
        // smooth heightfield normal before terraces become sub-pixel contour lines.
        float terrainBlend = lerp(0.72, 0.94, smoothstep(5.0, 28.0, hitDistance));
        normal = normalize(lerp(normal, terrainNormal, terrainBlend));
    }
    else if (material == 1u || material == 6u)
    {
        // Structural masonry should read as one carved volume, especially on cylindrical towers
        // and cave walls. Fade only at extreme range, where a voxel is already sub-pixel and the
        // extra occupancy probes cannot affect the silhouette.
        float3 volumeNormal = MasonryVolumeNormal(solidVoxel, faceNormal);
        float volumeBlend = 0.84 * (1.0 - smoothstep(180.0, 360.0, hitDistance));
        normal = normalize(lerp(faceNormal, volumeNormal, volumeBlend));
    }
    float3 albedo = g_MaterialColours[min(material, 15u)].rgb;
    bool foliageSurface = (material == 10u || material == 14u) && !naturalTerrainSurface;

    // The voxel material remains dominant. The authored maps contribute restrained colour
    // variation in world space, so region boundaries cannot introduce UV seams. Estimate the
    // mip from hit distance: compute shaders have no implicit pixel derivatives, and forcing mip
    // zero made distant terrain shimmer while turning wall detail into high-frequency noise.
    float textureLod = clamp(log2(max(1.0, hitDistance * 0.36)), 0.0, 8.0);
    float2 surfaceUv = SurfaceUV(normal, hitVoxel);
    float3 mappedNormal = SampleSurfaceNormal(material, surfaceUv, hitVoxel,
                                               hitDistance, normal, textureLod);
    float normalStrength = foliageSurface ? 0.04
                         : (material == 1u || material == 6u) ? 0.32 : 0.22;
    normalStrength *= 1.0 - smoothstep(18.0, 64.0, hitDistance);
    normal = normalize(lerp(normal, mappedNormal, normalStrength));

    float3 textured = SampleSurfaceTexture(material, surfaceUv, hitVoxel,
                                           hitDistance, albedo, textureLod);
    float textureWeight = lerp(0.28, 0.12, saturate(hitDistance / 350.0));

    if (foliageSurface)
    {
        // Tree crowns use the grass/moss palette but should not inherit a stretched terrain
        // painting. Broad per-cluster and fine leaf values make overlapping lobes readable while
        // keeping the renderer to one opaque voxel material.
        int3 leafCell = int3(floor(hitVoxel / 3.0));
        uint leafHash = FarHash((uint)leafCell.x * 73856093u
                              ^ (uint)leafCell.y * 19349663u
                              ^ (uint)leafCell.z * 83492791u);
        float leafValue = 0.76 + ((leafHash >> 24) & 255u) * (0.34 / 255.0);
        float upwardValue = lerp(0.82, 1.08, saturate(normal.y * 0.5 + 0.5));
        albedo *= leafValue * upwardValue;
        albedo = lerp(albedo, textured, 0.08);
    }
    else if (material == 1u)
    {
        // The stone map is intentionally pale blue and looks attractive in isolation, but using
        // that average colour directly bleaches an entire fortress. Preserve its painted chips,
        // mortar, and value changes around the palette's neutral masonry colour instead.
        float textureLuminance = dot(textured, float3(0.2126, 0.7152, 0.0722));
        float detail = clamp(textureLuminance / 0.68, 0.74, 1.20);
        float3 chroma = textured / max(textureLuminance, 0.08);
        albedo *= lerp(1.0, detail, 0.58);
        albedo *= lerp(1.0, chroma, 0.06);
    }
    else if (material == 6u)
    {
        // The source sheets for aged masonry and natural rock are deliberately warm paintings.
        // Taking their RGB average literally made foundations mauve and caves orange. Keep their
        // excellent cracks and block values, but grade them around the authored cool charcoal
        // palette; explicit moss voxels and local cave lights supply colour where it belongs.
        float textureLuminance = dot(textured, float3(0.2126, 0.7152, 0.0722));
        float detail = clamp(textureLuminance / 0.58, 0.68, 1.24);
        float3 chroma = textured / max(textureLuminance, 0.08);
        albedo *= lerp(1.0, detail, 0.72);
        albedo *= lerp(1.0, chroma, 0.025);
    }
    else
    {
        albedo = lerp(albedo, textured, textureWeight);
    }

    // The texture already contains its own brick/plank layout. Overlaying a second procedural
    // mortar grid produced doubled, misaligned courses. Broad deterministic value fields provide
    // the slow weathering visible across real masonry, while restrained voxel-scale variation
    // keeps repetition from returning without turning a tower into salt-and-pepper noise.
    if (material == 1u || material == 6u)
    {
        int3 cell = int3(floor(hitVoxel));
        uint h = FarHash((uint)cell.x * 73856093u ^ (uint)cell.y * 19349663u
                         ^ (uint)cell.z * 83492791u ^ material * 2654435761u);
        float fineVariation = 0.98 + ((h >> 24) & 255u) * (0.04 / 255.0);

        int3 macroCell = int3(floor(hitVoxel / 24.0));
        uint macroHash = FarHash((uint)macroCell.x * 1597334677u
                               ^ (uint)macroCell.y * 3812015801u
                               ^ (uint)macroCell.z * 958282787u
                               ^ material * 1103515245u);
        float macroVariation = 0.91 + ((macroHash >> 24) & 255u) * (0.16 / 255.0);
        albedo *= fineVariation * macroVariation;
    }

    float ndotl = saturate(dot(normal, g_SunDirection));
    float fill = saturate(dot(normal, -g_SunDirection)) * 0.06;

    float3 groundBounce = float3(0.20, 0.18, 0.16);
    float hemi = normal.y * 0.5 + 0.5;
    float3 ambient = lerp(groundBounce, SkyColour(normal), hemi) * 0.32;

    // Shadows cut the sun only; ambient still reaches a shadowed wall, or a north face would go
    // black again the moment it fell into shade. Launch with the actual hit face: a smoothed
    // cylinder normal can point through the stair-stepped voxel skin and self-shadow every other
    // column, which was the source of the towers' black vertical striping.
    float shadow = ndotl > 0.0 ? SunShadow(hitVoxel, faceNormal) : 1.0;
    float ao = Occlusion(hitVoxel, normal);
    float3 sunColour = float3(1.00, 0.78, 0.57);
    float3 viewToCamera = normalize(g_CameraPos / g_VoxelSize - hitVoxel);

    float3 lit = albedo * (ambient * lerp(0.58, 1.0, ao)
                         + sunColour * ndotl * shadow * 0.88
                         + fill * ao);

    if (foliageSurface)
    {
        float transmitted = saturate(dot(-normal, g_SunDirection));
        float rim = pow(1.0 - saturate(dot(normal, viewToCamera)), 2.0);
        lit += albedo * sunColour * (0.10 + transmitted * 0.20 + rim * 0.08);
    }

    // Even rough stone has a broad grazing response; slate, glass, wet moss, and water carry a
    // tighter highlight. This gives material changes a lighting consequence instead of making
    // every surface differ only by its base colour.
    float3 halfVector = normalize(g_SunDirection + viewToCamera);
    float roughness = material == 4u || material == 15u ? 0.24
                    : material == 7u || material == 8u ? 0.42
                    : material == 11u ? 0.18
                    : material == 14u ? 0.48 : 0.76;
    float specularPower = lerp(96.0, 9.0, roughness);
    float specularAmount = lerp(0.42, 0.035, roughness);
    float specular = pow(saturate(dot(normal, halfVector)), specularPower)
                   * specularAmount * shadow * ndotl;
    lit += sunColour * specular;

    // Authored room/cave lights. Unity's lighting buffers cannot shade this compute-owned colour
    // target, so a small fixed array is cheaper and more predictable than pretending point-light
    // GameObjects affect the voxels. Quadratic falloff keeps each pool local to its room and the
    // normal term preserves shape instead of applying a flat emissive wash.
    float3 hitMetres = hitVoxel * g_VoxelSize;
    [loop]
    for (uint lightIndex = 0u; lightIndex < min(g_LocalLightCount, 20u); lightIndex++)
    {
        float3 toLight = g_LocalLights[lightIndex].xyz - hitMetres;
        float distanceToLight = length(toLight);
        float radius = max(g_LocalLights[lightIndex].w, 0.01);
        float attenuation = saturate(1.0 - distanceToLight / radius);
        attenuation *= attenuation;
        float facing = saturate(dot(normal, toLight / max(distanceToLight, 0.001)));
        float shaped = attenuation * (0.18 + facing * 0.82);
        lit += albedo * g_LocalLightColours[lightIndex].rgb
             * (g_LocalLightColours[lightIndex].w * shaped);
    }

    if (g_FlashlightEnabled != 0u)
    {
        float3 lightToHit = hitMetres - g_FlashlightPosition;
        float flashlightDistance = length(lightToHit);
        float3 beamDirection = lightToHit / max(flashlightDistance, 0.001);
        float cone = smoothstep(g_FlashlightOuterCos, g_FlashlightInnerCos,
                                dot(beamDirection, normalize(g_FlashlightDirection)));
        float rangeFade = saturate(1.0 - flashlightDistance / max(g_FlashlightRange, 0.01));
        rangeFade *= rangeFade;
        float flashlightFacing = saturate(dot(normal, -beamDirection));
        float flashlightShape = cone * rangeFade * (0.12 + flashlightFacing * 0.88);
        lit += albedo * g_FlashlightColour.rgb
             * (g_FlashlightColour.w * flashlightShape);
    }

    // Enclosed rooms cannot receive Unity lights because this renderer owns its pixels. A soft,
    // short-range camera-side bounce stands in for eye adaptation / a carried torch and affects
    // only surfaces facing the viewer within roughly eighteen metres.
    float3 toCamera = g_CameraPos / g_VoxelSize - hitVoxel;
    float cameraDistance = length(toCamera) * g_VoxelSize;
    float cameraBounce = saturate(dot(normal, normalize(toCamera)))
                       * saturate(1.0 - cameraDistance / 18.0) * 0.24;
    lit += albedo * cameraBounce * float3(1.16, 0.78, 0.46);

    // Ordinary glass stays cool for water/crystals. Exterior leaded windows use a separate dark
    // material with a small amber interior response, avoiding the flat yellow stickers produced
    // when every glass voxel was emissive orange.
    if (material == 4u) lit += albedo * 0.10;
    if (material == 15u)
    {
        int3 paneCell = int3(floor(hitVoxel / 4.0));
        float pane = ((FarHash((uint)paneCell.x * 73856093u
                             ^ (uint)paneCell.y * 19349663u
                             ^ (uint)paneCell.z * 83492791u) >> 27) & 1u) != 0u
                   ? 1.0 : 0.55;
        lit += float3(0.26, 0.13, 0.045) * pane;
    }
    if (material == 12u) lit += albedo * 0.34;

    // Water is voxel-opaque, but the camera ray can still reflect the procedural sky. Fresnel
    // keeps a little river-bed colour at steep viewing angles while broad horizontal surfaces
    // become a bright mirror; vertical waterfall sheets retain the cooler translucent read.
    if (material == 11u)
    {
        float3 reflectedDirection = reflect(-viewToCamera, normal);
        float3 reflectedSky = PresentationSky(reflectedDirection);
        float facing = saturate(dot(normal, viewToCamera));
        float fresnel = 0.04 + 0.96 * pow(1.0 - facing, 5.0);
        float horizontal = smoothstep(0.45, 0.92, abs(normal.y));
        float reflectionWeight = lerp(0.24, 0.48 + fresnel * 0.34, horizontal);
        lit = lerp(lit, reflectedSky, reflectionWeight);
        // Water frequently sits beneath the east wall and tree canopy. Preserve a cool colour
        // floor there so the stream does not become indistinguishable from dark stone.
        lit += float3(0.018, 0.10, 0.14) * lerp(1.0, 0.45, horizontal);
    }

    // Tone map. Without it the bright faces clip flat and the whole image reads as washed-out
    // pastel, which no amount of geometry fixes.
    lit *= 1.02;
    lit = saturate((lit * (2.51 * lit + 0.03))
                 / (lit * (2.43 * lit + 0.59) + 0.14));
    float gradedLuminance = dot(lit, float3(0.2126, 0.7152, 0.0722));
    lit = lerp(gradedLuminance.xxx, lit, 0.88);

    // URP fog cannot affect this compute-owned colour target. Apply restrained aerial
    // perspective here so the streamed landscape and distant masonry settle into the same sky
    // as the procedural mountains. Keep the first sixty metres completely clear: interiors,
    // destruction feedback, and the playable face of the castle must retain full contrast.
    float3 viewDirection = normalize(hitVoxel * g_VoxelSize - g_CameraPos);
    float distanceFog = smoothstep(60.0, 300.0, hitDistance) * 0.40;
    float lowAltitude = 1.0 - smoothstep(32.0, 72.0, hitVoxel.y * g_VoxelSize);
    distanceFog *= lerp(0.82, 1.12, lowAltitude);
    return lerp(lit, SkyColour(viewDirection), saturate(distanceFog));
}

// -- implicit far field -------------------------------------------------------

int FarCorner(int x, int z, int salt)
{
    uint h = FarHash((uint)x * 2654435761u ^ (uint)z * 2246822519u ^ g_TerrainSeed ^ ((uint)salt << 24));
    return (int)((h >> 8) & 0x3FFu);
}

// 3t^2 - 2t^3 in fixed point. Unsigned rather than signed: the intermediate reaches ~1.07e9,
// which overflows a signed 32-bit multiply-add but fits comfortably in uint.
int FarSmooth(int f, int cell)
{
    uint t = (uint)((f * 1024) / cell);
    return (int)((t * t * (3u * 1024u - 2u * t)) >> 20);
}

int FarOctave(int wx, int wz, int log2Cell, int amplitude)
{
    int cell = 1 << log2Cell;
    int x0 = wx >> log2Cell, z0 = wz >> log2Cell;
    int fx = wx & (cell - 1), fz = wz & (cell - 1);

    int c00 = FarCorner(x0,     z0,     log2Cell);
    int c10 = FarCorner(x0 + 1, z0,     log2Cell);
    int c01 = FarCorner(x0,     z0 + 1, log2Cell);
    int c11 = FarCorner(x0 + 1, z0 + 1, log2Cell);

    int tx = FarSmooth(fx, cell);
    int tz = FarSmooth(fz, cell);

    int a = c00 + (((c10 - c00) * tx) >> 10);
    int b = c01 + (((c11 - c01) * tx) >> 10);
    int v = a + (((b - a) * tz) >> 10);

    return ((v * amplitude) >> 10) - (amplitude >> 1);
}

// Surface height in voxels. Must match ShowcaseWorld.SurfaceHeight or the horizon will not
// meet the voxels at the transition.
int FarSurfaceHeight(int wx, int wz)
{
    int h = (int)g_FarBaseHeight;
    h += FarOctave(wx, wz, 9, 70);
    h += FarOctave(wx, wz, 7, 24);
    h += FarOctave(wx, wz, 5, 6);
    h += FarOctave(wx, wz, 4, 4);
    return clamp(h, 8, 512 - 24);
}

float FarHeightMetres(float3 p)
{
    int wx = (int)floor(p.x / g_VoxelSize);
    int wz = (int)floor(p.z / g_VoxelSize);

    float terrain = FarSurfaceHeight(wx, wz) * g_VoxelSize;

    // The authored voxel volume owns the playable landscape around the castle. Beyond it, build
    // broad mountain masses for composition only: they frame the skyline like the concept art
    // without creating CPU geometry, collision, or save-state that the player could reach. The
    // Keep the authored castle volume clear, then rise decisively into the high enclosing peaks
    // in the reference. The long blend still supplies foothills instead of a circular wall.
    float castleRadius = length(p.xz - float2(25.6, 37.6));
    float mountainEnvelope = smoothstep(105.0, 285.0, castleRadius);

    float broad = FarOctave(wx, wz, 11, 1024) / 1024.0 + 0.5;
    float medium = FarOctave(wx, wz, 9, 1024) / 1024.0 + 0.5;
    float fine = FarOctave(wx, wz, 7, 1024) / 1024.0 + 0.5;
    float ridge = 1.0 - abs(broad * 2.0 - 1.0);
    float peaks = pow(saturate(ridge * 0.78 + medium * 0.32 + fine * 0.12 - 0.24), 1.65);
    float mountains = mountainEnvelope * (12.0 + peaks * 108.0);

    return terrain + mountains;
}

// Marches the procedural heightfield from tStart outward. Steps grow with distance: near the
// transition the surface must be met precisely, far away a pixel covers many metres.
bool MarchFarField(float3 origin, float3 dir, float tStart, out float3 colour)
{
    colour = float3(0, 0, 0);

    // Canonical terrain tops out around 49 m, while the presentation-only background can reach
    // roughly 165 m. This is only an early-out ceiling; it does not change the voxel world bounds.
    float maxHeight = 180.0;
    float3 p = origin + dir * tStart;

    // Looking up from above everything: nothing to find.
    if (dir.y >= 0.0 && p.y > maxHeight) return false;

    float t = tStart;
    float step = max(1.0, tStart * 0.01);
    float previousGap = p.y - FarHeightMetres(p);

    [loop]
    for (uint i = 0u; i < 192u; i++)
    {
        t += step;
        if (t > g_FarDistance) return false;

        p = origin + dir * t;
        if (dir.y > 0.0 && p.y > maxHeight) return false;

        float gap = p.y - FarHeightMetres(p);

        if (gap <= 0.0)
        {
            // Crossed the surface: bisect back to it so the silhouette is not stepped.
            float lo = t - step, hi = t;
            for (uint b = 0u; b < 12u; b++)
            {
                float mid = 0.5 * (lo + hi);
                float3 q = origin + dir * mid;
                if (q.y - FarHeightMetres(q) <= 0.0) hi = mid; else lo = mid;
            }

            p = origin + dir * hi;

            // Normal from finite differences of the height field, spaced by the local step so
            // distant terrain does not shade as noise.
            float e = max(g_VoxelSize, hi * 0.004);
            float hL = FarHeightMetres(p - float3(e, 0, 0));
            float hR = FarHeightMetres(p + float3(e, 0, 0));
            float hD = FarHeightMetres(p - float3(0, 0, e));
            float hU = FarHeightMetres(p + float3(0, 0, e));
            float3 normal = normalize(float3(hL - hR, 2.0 * e, hD - hU));

            float castleRadius = length(p.xz - float2(25.6, 37.6));
            float mountainBlend = smoothstep(125.0, 325.0, castleRadius);
            uint material = mountainBlend > 0.42
                ? 6u
                : (p.y < (float)g_FarBaseHeight * g_VoxelSize ? 3u : 10u);
            colour = Shade(material, normal, p / g_VoxelSize);

            // Mountains get atmospheric perspective early enough to sit behind the castle rather
            // than competing with it; the terrain horizon keeps its original long-distance fade.
            float haze = saturate((hi - g_FarDistance * 0.35) / (g_FarDistance * 0.65));
            float mountainHaze = mountainBlend * smoothstep(190.0, 1050.0, hi) * 0.42;
            colour = lerp(colour, SkyColour(dir), max(haze * 0.85, mountainHaze));
            return true;
        }

        previousGap = gap;
        step *= 1.03;
    }

    return false;
}

// -- traversal ----------------------------------------------------------------

// Marches the 8^3 voxels of one brick. Uniform bricks normally stop in the outer DDA without
// descending, but a cutaway may cross only part of one and therefore needs voxel resolution.
uint MarchBrick(int brickRef, int3 brickCoord, float3 entryVoxel, float3 dir,
                out float3 normal, out float tHit)
{
    normal = float3(0, 1, 0);
    tHit = 0;

    int3 v = clamp(int3(floor(entryVoxel)), 0, k_BrickEdge - 1);
    int3 step = int3(dir.x >= 0 ? 1 : -1, dir.y >= 0 ? 1 : -1, dir.z >= 0 ? 1 : -1);

    float3 invDir = 1.0 / max(abs(dir), 1e-8);
    float3 nextBoundary = float3(step.x > 0 ? v.x + 1 : v.x,
                                 step.y > 0 ? v.y + 1 : v.y,
                                 step.z > 0 ? v.z + 1 : v.z);
    float3 tMax = (nextBoundary - entryVoxel) * invDir * float3(sign(dir.x) != 0 ? 1 : 0,
                                                                sign(dir.y) != 0 ? 1 : 0,
                                                                sign(dir.z) != 0 ? 1 : 0);
    tMax = abs(tMax);
    float3 tDelta = invDir;

    int axis = 1;

    // 8^3 needs at most 22 steps to cross corner to corner.
    [loop]
    for (uint i = 0; i < 24u; i++)
    {
        uint material = brickRef < -1
            ? (uint)(-brickRef - 1)
            : VoxelMaterial(brickRef, v);
        int3 worldVoxel = brickCoord * k_BrickEdge + v;
        if (material != 0u && !PresentationClipped(worldVoxel))
        {
            normal = float3(axis == 0 ? -step.x : 0, axis == 1 ? -step.y : 0, axis == 2 ? -step.z : 0);
            return material;
        }

        if (tMax.x < tMax.y && tMax.x < tMax.z)      { v.x += step.x; tHit = tMax.x; tMax.x += tDelta.x; axis = 0; }
        else if (tMax.y < tMax.z)                    { v.y += step.y; tHit = tMax.y; tMax.y += tDelta.y; axis = 1; }
        else                                         { v.z += step.z; tHit = tMax.z; tMax.z += tDelta.z; axis = 2; }

        if (any(v < 0) || any(v >= k_BrickEdge)) break;
    }

    return 0u;
}

[numthreads(8, 8, 1)]
void CSBrickRaymarch(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)g_TargetSize.x || id.y >= (uint)g_TargetSize.y) return;

    // Per-pixel ray from the inverse view-projection. Reconstructing the ray here rather than
    // receiving it per pixel is what makes this a raymarcher instead of a blit.
    float2 uv = (float2(id.xy) + 0.5) / g_TargetSize;
    float2 ndc = uv * 2.0 - 1.0;

    // Unproject one point and aim at it from the camera. Differencing two depths instead
    // (far minus near) looks equivalent and is not: Unity uses reversed-Z on Metal and
    // Vulkan, where NDC depth 0 is the far plane, so that subtraction points the ray out of
    // the back of the camera and every pixel returns sky. Any valid depth unprojects to a
    // point in front of the camera, so this form does not care which convention is in use.
    float4 h = mul(g_InvViewProj, float4(ndc, 0.5, 1.0));
    float3 target = h.xyz / h.w;
    float3 dir = normalize(target - g_CameraPos);

    // Brick space: one unit per brick, which is what the outer DDA steps through.
    float brickSize = g_VoxelSize * k_BrickEdge;
    float3 origin = g_CameraPos / brickSize;

    int3 brick = int3(floor(origin));
    int3 step = int3(dir.x >= 0 ? 1 : -1, dir.y >= 0 ? 1 : -1, dir.z >= 0 ? 1 : -1);

    float3 invDir = 1.0 / max(abs(dir), 1e-8);
    float3 nextBoundary = float3(step.x > 0 ? brick.x + 1 : brick.x,
                                 step.y > 0 ? brick.y + 1 : brick.y,
                                 step.z > 0 ? brick.z + 1 : brick.z);
    float3 tMax = abs((nextBoundary - origin) * invDir);
    float3 tDelta = invDir;

    float t = 0.0;
    int axis = 1;
    float maxT = g_MaxDistance / brickSize;

    float3 colour = SkyColour(dir);
    bool hit = false;

    // Traversal telemetry, reported by the debug modes below.
    float sawSlot = 0.0;      // the ray entered a region that is mirrored on the GPU
    float sawRef = 0.0;       // it found a non-empty brick pointer there
    float sawMixed = 0.0;     // that pointer referenced pool storage
    float sawVoxel = 0.0;     // and that storage held a non-empty voxel
    float steps = 0.0;

    [loop]
    for (uint i = 0; i < g_MaxSteps; i++)
    {
        if (t > maxT) break;

        steps += 1.0;

        if (RegionSlot(brick >> k_RegionEdgeLog2) >= 0) sawSlot = 1.0;

        int brickRef = BrickRefAt(brick);

        if (brickRef != -1)
        {
            sawRef = 1.0;
            float3 normal = float3(axis == 0 ? -step.x : 0, axis == 1 ? -step.y : 0, axis == 2 ? -step.z : 0);

            if (brickRef < -1 && g_CutawayEnabled == 0u)
            {
                // Uniform, non-empty: the pointer itself carries the material. No memory read.
                // Brick space to voxel space. The outer DDA steps bricks, so the hit position is
                // in brick units and the occlusion sampler reads voxels — passing one for the
                // other put every shadow ray eight times too close and shadowed the whole world.
                colour = Shade((uint)(-brickRef - 1), normal, (origin + dir * t) * k_BrickEdge);
                hit = true;
                break;
            }

            // Mixed: descend. Entry point in voxel coordinates within this brick.
            float3 entry = (origin + dir * (t + 1e-4)) - float3(brick);
            float3 entryVoxel = clamp(entry * k_BrickEdge, 0.0, k_BrickEdge - 1e-3);

            if (brickRef >= 0) sawMixed = 1.0;

            float3 hitNormal;
            float tInner;
            uint material = MarchBrick(brickRef, brick, entryVoxel, dir, hitNormal, tInner);

            if (material != 0u) sawVoxel = 1.0;

            if (material != 0u)
            {
                colour = Shade(material, hitNormal,
                               (origin + dir * t) * k_BrickEdge + dir * tInner);
                hit = true;
                break;
            }
        }

        if (tMax.x < tMax.y && tMax.x < tMax.z)      { brick.x += step.x; t = tMax.x; tMax.x += tDelta.x; axis = 0; }
        else if (tMax.y < tMax.z)                    { brick.y += step.y; t = tMax.y; tMax.y += tDelta.y; axis = 1; }
        else                                         { brick.z += step.z; t = tMax.z; tMax.z += tDelta.z; axis = 2; }
    }

    // Nothing in the resident set: hand the ray to the procedural horizon.
    if (!hit && g_FarEnabled != 0u && g_FarDistance > 0.0)
    {
        float3 farColour;
        if (MarchFarField(g_CameraPos, dir, max(t * brickSize, 1.0), farColour))
        {
            colour = farColour;
            hit = true;
        }
    }

    if (g_DebugMode == 1u) { colour = float3(sawSlot, sawRef, sawMixed); hit = true; }
    else if (g_DebugMode == 2u) { colour = float3(sawVoxel, steps / max(1.0, (float)g_MaxSteps), 0.0); hit = true; }

    // The compute target owns the opaque landscape, including its presentation sky. Transparent
    // URP effects render after this pass, so tornadoes and HUD elements remain composited above
    // it while misses no longer expose the scene's flat default clear colour.
    if (!hit)
    {
        colour = PresentationSky(dir);
        hit = true;
    }

    // Write flipped vertically rather than building the ray from a flipped uv: the rays are
    // correct as constructed, it is the target's row order that disagrees with the blit. Doing
    // it on the uv instead aims every ray at the sky, which is how that mistake presents.
    g_Colour[uint2(id.x, (uint)g_TargetSize.y - 1u - id.y)] = float4(colour, 1.0);
}

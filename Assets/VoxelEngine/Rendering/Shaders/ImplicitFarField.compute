#pragma kernel CSMain

// Mip texture for far-field raymarching — one mip level per distance band.
RWTexture2D<float4> g_FarFieldMip;

// Region occupancy mip data: structured buffer of aggregated occupancy words.
StructuredBuffer<uint> g_RegionMipData;

cbuffer cbFarFieldParams : register(b0)
{
    float4  g_CamOriginViewSpace;  // camera origin in view space for ray calculations
    float2  g_FarFieldStartEnd;     // x = far field start (mip5+ distance), y = max view distance
    float2  g_RenderScale;          // x = render scale fraction, y = upscale factor
    uint    g_MipLevels;            // number of mip levels available
    uint    g_ResolutionX;
    uint    g_ResolutionY;
}

// Implicit far-field raymarch over mip textures for distant rendering.
// Lower fidelity path: uses pre-aggregated mip data instead of raw brick data,
// reducing bandwidth and compute while maintaining visual continuity at distance.
[numthreads(16, 16, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint px = id.x;
    uint py = id.y;
    uint pz = id.z;

    if (px >= g_ResolutionX || py >= g_ResolutionY)
        return;

    // Sample the mip texture at this pixel's far-field level.
    uint mipLevel = min(g_MipLevels - 1u, max(5u, uint(px) / 32u));
    uint2 mipCoord = uint2(px >> mipLevel, py >> mipLevel);

    if (mipCoord.x >= g_ResolutionX || mipCoord.y >= g_ResolutionY)
        return;

    // Read aggregated occupancy from the mip texture.
    float4 mipSample = g_FarFieldMip[mipCoord];
    bool isSolid = mipSample.r > 0.0f;

    if (isSolid)
    {
        // Far-field rendering: approximate the brick surface with mip-level color.
        g_FarFieldMip[id.xy] = float4(mipSample.rgb, 1.0f);
    }
    else
    {
        // Empty space in the far field — skip to next mip level.
        if (mipLevel < min(g_MipLevels - 1u, uint(g_FarFieldStartEnd.y / g_FarFieldStartEnd.x)))
        {
            // Propagate upward — already handled by mip chain on CPU side.
        }
        else
        {
            // True empty space: sky color.
            g_FarFieldMip[id.xy] = float4(0.53, 0.81, 0.92, 1.0);
        }
    }
}

// Mip chain generation kernel: builds each mip level from the one below it.
[numthreads(8, 8, 1)]
void CSGenerateMip(uint3 id : SV_DispatchThreadID)
{
    uint srcLevel = id.x;
    if (srcLevel >= g_MipLevels - 1u)
        return;

    uint dstLevel = srcLevel + 1u;
    uint2 srcSize  = uint2(g_ResolutionX >> srcLevel, g_ResolutionY >> srcLevel);
    uint2 dstSize  = uint2(g_ResolutionX >> dstLevel, g_ResolutionY >> dstLevel);

    if (id.x >= dstSize.x || id.y >= dstSize.y)
        return;

    // Aggregate four child samples into one parent via bitwise OR on occupancy channels.
    float4 agg = 0.0f;
    for (int dy = 0; dy < 2; dy++)
    {
        for (int dx = 0; dx < 2; dx++)
        {
            uint2 childCoord = id.xy * 2 + uint2(dx, dy);
            if (childCoord.x < srcSize.x && childCoord.y < srcSize.y)
            {
                float4 sample = g_FarFieldMip[childCoord];
                agg.r |= (uint)(sample.r > 0.0f);
                agg.g += sample.g; // Average intensity for lighting.
                agg.b += sample.b;
            }
        }
    }

    agg.g /= 4.0f;
    agg.b /= 4.0f;
    g_FarFieldMip[id.xy] = agg;
}

#pragma kernel CSAllocateBatchPages
#pragma kernel CSPublishBatchPages
#pragma kernel CSCommitPendingPages
#pragma kernel CSCommitCurrentPendingPages
#pragma kernel CSAbortPendingPages
#pragma kernel CSApplyHandleCommands

// GPU-owned page allocation for voxel presentation geometry. The CPU assigns stable chunk handles
// and authoritative renderer generations. Allocation/write creates a pending candidate; only a
// later identity-checked Commit can replace live geometry. CPU feedback is limited to the existing
// small batch status/identity records, never generated vertices or indices.

struct BatchChunkDescriptor
{
    int3 chunkOriginVoxel;
    int sourceStep;
    uint transitionFaceMask;
    float voxelSize;
    uint handle;
    uint generationLow;
    uint generationHigh;
};

struct ChunkGeometryRecord
{
    uint generationLow;
    uint generationHigh;
    uint bank;
    uint vertexCount;
    uint indexCount;
    uint vertexPageCount;
    uint indexPageCount;
    uint ready;
};

struct RetiredPage
{
    uint page;
    uint readyEpoch;
};

struct HandleCommand
{
    uint handle;
    uint generationLow;
    uint generationHigh;
    uint release;
};

StructuredBuffer<BatchChunkDescriptor> _BatchChunks;
RWStructuredBuffer<uint> _BatchCounters;
StructuredBuffer<uint> _BatchCountersRead;
RWStructuredBuffer<uint> _ArenaState;
RWStructuredBuffer<uint> _FreeVertexPages;
RWStructuredBuffer<uint> _FreeIndexPages;
RWStructuredBuffer<RetiredPage> _RetiredVertexPages;
RWStructuredBuffer<RetiredPage> _RetiredIndexPages;
StructuredBuffer<RetiredPage> _RetiredVertexPagesRead;
StructuredBuffer<RetiredPage> _RetiredIndexPagesRead;
RWStructuredBuffer<uint2> _DesiredGenerations;
StructuredBuffer<uint2> _DesiredGenerationsRead;
StructuredBuffer<HandleCommand> _HandleCommands;
RWStructuredBuffer<ChunkGeometryRecord> _LiveChunkGeometry;
RWStructuredBuffer<ChunkGeometryRecord> _PendingChunkGeometry;
StructuredBuffer<ChunkGeometryRecord> _LiveChunkGeometryRead;
StructuredBuffer<ChunkGeometryRecord> _PendingChunkGeometryRead;
RWStructuredBuffer<uint> _VertexPageTable;
RWStructuredBuffer<uint> _IndexPageTable;
StructuredBuffer<uint> _VertexPageTableRead;
StructuredBuffer<uint> _IndexPageTableRead;

int _BatchRecordCount;
int _BatchRecordWords;
int _VertexPageSize;
int _IndexPageSize;
int _MaxVertexPagesPerChunk;
int _MaxIndexPagesPerChunk;
int _VertexPageCount;
int _IndexPageCount;
int _HandleCapacity;
uint _ArenaEpoch;
uint _RetirementDelay;
int _HandleCommandCount;
int _PendingHandle;
uint _PendingGenerationLow;
uint _PendingGenerationHigh;

static const uint AllocationReady = 0u;
static const uint AllocationExhausted = 1u;
static const uint AllocationStale = 2u;
static const uint AllocationTooLarge = 3u;
static const uint AllocationUnsupported = 4u;

int RecordWord(int record) { return 4 + record * _BatchRecordWords; }
int VertexTableWord(uint handle, uint bank, uint page)
{
    return ((int)handle * 2 + (int)bank) * _MaxVertexPagesPerChunk + (int)page;
}
int IndexTableWord(uint handle, uint bank, uint page)
{
    return ((int)handle * 2 + (int)bank) * _MaxIndexPagesPerChunk + (int)page;
}

void ReclaimVertexPages()
{
    uint head = _ArenaState[2], tail = _ArenaState[3];
    while (head < tail)
    {
        RetiredPage retired = _RetiredVertexPagesRead[head % (uint)_VertexPageCount];
        if (retired.readyEpoch > _ArenaEpoch) break;
        _FreeVertexPages[_ArenaState[0]++] = retired.page;
        head++;
    }
    _ArenaState[2] = head;
}

void ReclaimIndexPages()
{
    uint head = _ArenaState[4], tail = _ArenaState[5];
    while (head < tail)
    {
        RetiredPage retired = _RetiredIndexPagesRead[head % (uint)_IndexPageCount];
        if (retired.readyEpoch > _ArenaEpoch) break;
        _FreeIndexPages[_ArenaState[1]++] = retired.page;
        head++;
    }
    _ArenaState[4] = head;
}

void RetireVertexPage(uint page)
{
    uint tail = _ArenaState[3]++;
    RetiredPage retired; retired.page = page;
    retired.readyEpoch = _ArenaEpoch + _RetirementDelay;
    _RetiredVertexPages[tail % (uint)_VertexPageCount] = retired;
}

void RetireIndexPage(uint page)
{
    uint tail = _ArenaState[5]++;
    RetiredPage retired; retired.page = page;
    retired.readyEpoch = _ArenaEpoch + _RetirementDelay;
    _RetiredIndexPages[tail % (uint)_IndexPageCount] = retired;
}

void RetireVertexPageAtomic(uint page)
{
    uint tail;
    InterlockedAdd(_ArenaState[3], 1u, tail);
    RetiredPage retired; retired.page = page;
    retired.readyEpoch = _ArenaEpoch + _RetirementDelay;
    _RetiredVertexPages[tail % (uint)_VertexPageCount] = retired;
}

void RetireIndexPageAtomic(uint page)
{
    uint tail;
    InterlockedAdd(_ArenaState[5], 1u, tail);
    RetiredPage retired; retired.page = page;
    retired.readyEpoch = _ArenaEpoch + _RetirementDelay;
    _RetiredIndexPages[tail % (uint)_IndexPageCount] = retired;
}

void RetirePending(uint handle, ChunkGeometryRecord pending)
{
    if (pending.ready == 0u) return;
    for (uint page = 0u; page < pending.vertexPageCount; page++)
        RetireVertexPage(_VertexPageTableRead[VertexTableWord(handle,pending.bank,page)]);
    for (uint page = 0u; page < pending.indexPageCount; page++)
        RetireIndexPage(_IndexPageTableRead[IndexTableWord(handle,pending.bank,page)]);
    pending.ready = 0u;
    _PendingChunkGeometry[handle] = pending;
}

// Pending candidates have never been exposed to draw consumers. Once queue ordering reaches the
// next allocator, their writer is complete, so a superseded pending candidate can return its pages
// directly to the free stacks. Live pages still use delayed retirement everywhere else.
void RecyclePending(uint handle, ChunkGeometryRecord pending)
{
    if (pending.ready == 0u) return;
    for (uint page = 0u; page < pending.vertexPageCount; page++)
        _FreeVertexPages[_ArenaState[0]++] =
            _VertexPageTableRead[VertexTableWord(handle,pending.bank,page)];
    for (uint page = 0u; page < pending.indexPageCount; page++)
        _FreeIndexPages[_ArenaState[1]++] =
            _IndexPageTableRead[IndexTableWord(handle,pending.bank,page)];
    pending.ready = 0u;
    _PendingChunkGeometry[handle] = pending;
}

[numthreads(64, 1, 1)]
void CSApplyHandleCommands(uint3 id : SV_DispatchThreadID)
{
    int commandIndex = (int)id.x;
    if (commandIndex >= _HandleCommandCount) return;
    HandleCommand command = _HandleCommands[commandIndex];
    _DesiredGenerations[command.handle] = uint2(command.generationLow,command.generationHigh);
    if (command.release == 0u) return;

    ChunkGeometryRecord pending = _PendingChunkGeometryRead[command.handle];
    if (pending.ready != 0u)
    {
        for (uint page=0u;page<pending.vertexPageCount;page++)
            RetireVertexPageAtomic(
                _VertexPageTableRead[VertexTableWord(command.handle,pending.bank,page)]);
        for (uint page=0u;page<pending.indexPageCount;page++)
            RetireIndexPageAtomic(
                _IndexPageTableRead[IndexTableWord(command.handle,pending.bank,page)]);
        pending.ready=0u;
        _PendingChunkGeometry[command.handle]=pending;
    }

    ChunkGeometryRecord live = _LiveChunkGeometryRead[command.handle];
    if (live.ready != 0u)
    {
        for (uint page=0u;page<live.vertexPageCount;page++)
            RetireVertexPageAtomic(
                _VertexPageTableRead[VertexTableWord(command.handle,live.bank,page)]);
        for (uint page=0u;page<live.indexPageCount;page++)
            RetireIndexPageAtomic(
                _IndexPageTableRead[IndexTableWord(command.handle,live.bank,page)]);
    }
    live.ready=0u;
    _LiveChunkGeometry[command.handle]=live;
}

[numthreads(1, 1, 1)]
void CSAllocateBatchPages(uint3 id : SV_DispatchThreadID)
{
    ReclaimVertexPages();
    ReclaimIndexPages();
    for (int record = 0; record < _BatchRecordCount; record++)
    {
        int word = RecordWord(record);
        BatchChunkDescriptor chunk = _BatchChunks[record];
        _BatchCounters[word + 10] = AllocationStale;
        _BatchCounters[word + 11] = chunk.handle;
        _BatchCounters[word + 12] = chunk.generationLow;
        _BatchCounters[word + 13] = chunk.generationHigh;
        uint2 desired = _DesiredGenerationsRead[chunk.handle];
        if (desired.x != chunk.generationLow || desired.y != chunk.generationHigh) continue;

        // Word zero is the semantic-support result produced by the count pass. Do not allocate an
        // apparently successful empty candidate for semantics the production GPU path deliberately
        // rejected; the CPU result channel must see Unsupported instead of false publication.
        if (_BatchCountersRead[word + 0] != 0u)
        {
            _BatchCounters[word + 10] = AllocationUnsupported;
            continue;
        }

        uint vertexCount = _BatchCounters[word + 2];
        uint indexCount = _BatchCounters[word + 3];
        uint vertexPages = (vertexCount + (uint)_VertexPageSize - 1u) / (uint)_VertexPageSize;
        uint indexPages = (indexCount + (uint)_IndexPageSize - 1u) / (uint)_IndexPageSize;
        if (vertexPages > (uint)_MaxVertexPagesPerChunk
         || indexPages > (uint)_MaxIndexPagesPerChunk)
        {
            _BatchCounters[word + 10] = AllocationTooLarge;
            _ArenaState[6]++;
            continue;
        }

        // Only one pending allocation may own a handle. A later renderer generation may replace a
        // completed-but-uncommitted candidate, but a failed replacement must leave that candidate
        // intact. Count its pages as immediately reusable only after the replacement is known to fit.
        ChunkGeometryRecord oldPending = _PendingChunkGeometryRead[chunk.handle];
        uint availableVertexPages = _ArenaState[0]
            + (oldPending.ready != 0u ? oldPending.vertexPageCount : 0u);
        uint availableIndexPages = _ArenaState[1]
            + (oldPending.ready != 0u ? oldPending.indexPageCount : 0u);
        if (vertexPages > availableVertexPages || indexPages > availableIndexPages)
        {
            _BatchCounters[word + 10] = AllocationExhausted;
            _ArenaState[6]++;
            continue;
        }
        if (oldPending.ready != 0u)
            RecyclePending(chunk.handle, oldPending);

        ChunkGeometryRecord live = _LiveChunkGeometryRead[chunk.handle];
        uint bank = live.ready != 0u ? 1u - live.bank : 0u;
        for (uint page = 0u; page < vertexPages; page++)
            _VertexPageTable[VertexTableWord(chunk.handle, bank, page)] =
                _FreeVertexPages[--_ArenaState[0]];
        for (uint page = 0u; page < indexPages; page++)
            _IndexPageTable[IndexTableWord(chunk.handle, bank, page)] =
                _FreeIndexPages[--_ArenaState[1]];

        ChunkGeometryRecord pending;
        pending.generationLow = chunk.generationLow;
        pending.generationHigh = chunk.generationHigh;
        pending.bank = bank;
        pending.vertexCount = vertexCount;
        pending.indexCount = indexCount;
        pending.vertexPageCount = vertexPages;
        pending.indexPageCount = indexPages;
        pending.ready = 1u;
        _PendingChunkGeometry[chunk.handle] = pending;
        _BatchCounters[word + 10] = AllocationReady;
        _BatchCounters[word + 14] = bank;
        _BatchCounters[word + 15] = vertexPages;
        _BatchCounters[word + 16] = indexPages;
    }
}

// Finalization is intentionally not publication. This kernel runs after geometry writes so the
// subsequent tiny status readback is ordered after all candidate consumers. A superseded desired
// generation is converted to Stale and its pending pages are reclaimed; a current candidate stays
// pending until a later identity-checked commit.
[numthreads(1, 1, 1)]
void CSPublishBatchPages(uint3 id : SV_DispatchThreadID)
{
    for (int record = 0; record < _BatchRecordCount; record++)
    {
        int word = RecordWord(record);
        if (_BatchCountersRead[word + 10] != AllocationReady) continue;
        uint handle = _BatchCountersRead[word + 11];
        ChunkGeometryRecord pending = _PendingChunkGeometryRead[handle];
        uint2 desired = _DesiredGenerationsRead[handle];
        bool samePending = pending.ready != 0u
            && pending.generationLow == _BatchCountersRead[word + 12]
            && pending.generationHigh == _BatchCountersRead[word + 13];
        bool current = samePending
            && desired.x == pending.generationLow
            && desired.y == pending.generationHigh;
        if (current) continue;

        if (samePending) RetirePending(handle, pending);
        _BatchCounters[word + 10] = AllocationStale;
    }
}

[numthreads(1, 1, 1)]
void CSCommitPendingPages(uint3 id : SV_DispatchThreadID)
{
    uint handle = (uint)_PendingHandle;
    ChunkGeometryRecord pending = _PendingChunkGeometryRead[handle];
    if (pending.ready == 0u
        || pending.generationLow != _PendingGenerationLow
        || pending.generationHigh != _PendingGenerationHigh)
        return;

    uint2 desired = _DesiredGenerationsRead[handle];
    if (desired.x != pending.generationLow || desired.y != pending.generationHigh)
    {
        RetirePending(handle, pending);
        return;
    }

    ChunkGeometryRecord live = _LiveChunkGeometryRead[handle];
    if (live.ready != 0u)
    {
        for (uint page = 0u; page < live.vertexPageCount; page++)
            RetireVertexPage(_VertexPageTableRead[VertexTableWord(handle,live.bank,page)]);
        for (uint page = 0u; page < live.indexPageCount; page++)
            RetireIndexPage(_IndexPageTableRead[IndexTableWord(handle,live.bank,page)]);
    }
    _LiveChunkGeometry[handle] = pending;
    pending.ready = 0u;
    _PendingChunkGeometry[handle] = pending;
}

// Production bridge while the stronger cache/config identity gate is being split out of the mixed
// legacy cache: commit only candidates whose handle's desired generation still matches. It runs at
// end-of-frame after count/write/finalization commands, so a candidate becomes visible no earlier
// than the next frame. Status failures never allocate pending geometry and therefore cannot pass.
[numthreads(64, 1, 1)]
void CSCommitCurrentPendingPages(uint3 id : SV_DispatchThreadID)
{
    uint handle = id.x;
    if (handle >= (uint)_HandleCapacity) return;
    ChunkGeometryRecord pending = _PendingChunkGeometryRead[handle];
    if (pending.ready == 0u) return;
    uint2 desired = _DesiredGenerationsRead[handle];
    if (desired.x != pending.generationLow || desired.y != pending.generationHigh) return;

    ChunkGeometryRecord live = _LiveChunkGeometryRead[handle];
    if (live.ready != 0u)
    {
        for (uint page = 0u; page < live.vertexPageCount; page++)
            RetireVertexPageAtomic(_VertexPageTableRead[VertexTableWord(handle,live.bank,page)]);
        for (uint page = 0u; page < live.indexPageCount; page++)
            RetireIndexPageAtomic(_IndexPageTableRead[IndexTableWord(handle,live.bank,page)]);
    }
    _LiveChunkGeometry[handle] = pending;
    pending.ready = 0u;
    _PendingChunkGeometry[handle] = pending;
}

[numthreads(1, 1, 1)]
void CSAbortPendingPages(uint3 id : SV_DispatchThreadID)
{
    uint handle = (uint)_PendingHandle;
    ChunkGeometryRecord pending = _PendingChunkGeometryRead[handle];
    if (pending.ready == 0u
        || pending.generationLow != _PendingGenerationLow
        || pending.generationHigh != _PendingGenerationHigh)
        return;
    RetirePending(handle, pending);
}

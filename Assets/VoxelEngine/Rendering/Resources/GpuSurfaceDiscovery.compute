#pragma kernel CSClearRegionMap
#pragma kernel CSIndexRegions
#pragma kernel CSQueryDiscovery

StructuredBuffer<uint> _DiscoveryWords;
RWStructuredBuffer<uint> _DiscoveryMap;
uint _DiscoveryRegionCount;
uint _DiscoveryMapCapacity;
StructuredBuffer<int4> _DiscoveryQueries; // chunk coordinate xyz, source step
RWStructuredBuffer<uint> _DiscoveryResults; // 1 only for a completed known-empty proof
uint _DiscoveryQueryCount;

uint RegionHash(int3 region)
{
    uint3 value=asuint(region);
    return (value.x*73856093u ^ value.y*19349663u ^ value.z*83492791u)&(_DiscoveryMapCapacity-1u);
}

[numthreads(64,1,1)]
void CSClearRegionMap(uint3 id:SV_DispatchThreadID)
{
    if(id.x<_DiscoveryMapCapacity)_DiscoveryMap[id.x]=0u;
}

[numthreads(64,1,1)]
void CSIndexRegions(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=_DiscoveryRegionCount)return;
    uint base=id.x*20u;
    int3 region=int3(_DiscoveryWords[base],_DiscoveryWords[base+1u],_DiscoveryWords[base+2u]);
    uint slot=RegionHash(region);
    for(uint probe=0u;probe<_DiscoveryMapCapacity;probe++)
    {
        uint prior;
        InterlockedCompareExchange(_DiscoveryMap[slot],0u,id.x+1u,prior);
        if(prior==0u)return;
        slot=(slot+1u)&(_DiscoveryMapCapacity-1u);
    }
}

bool DiscoveryCellIsEmpty(int3 fine)
{
    int3 region=fine>>3;
    uint slot=RegionHash(region);
    for(uint probe=0u;probe<_DiscoveryMapCapacity;probe++)
    {
        uint entry=_DiscoveryMap[slot];
        if(entry==0u)return false;
        uint base=(entry-1u)*20u;
        int3 key=int3(_DiscoveryWords[base],_DiscoveryWords[base+1u],_DiscoveryWords[base+2u]);
        if(all(key==region))
        {
            if(_DiscoveryWords[base+3u]==0u)return false;
            uint3 local=asuint(fine)&7u;
            uint bit=local.x+8u*(local.y+8u*local.z);
            return (_DiscoveryWords[base+4u+(bit>>5)]&(1u<<(bit&31u)))==0u;
        }
        slot=(slot+1u)&(_DiscoveryMapCapacity-1u);
    }
    return false;
}

[numthreads(64,1,1)]
void CSQueryDiscovery(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=_DiscoveryQueryCount)return;
    int4 query=_DiscoveryQueries[id.x];
    bool empty=query.w==1 || query.w==2 || query.w==4 || query.w==8;
    int3 min=query.xyz*query.w;
    for(int z=0;empty && z<query.w;z++)
    for(int y=0;empty && y<query.w;y++)
    for(int x=0;empty && x<query.w;x++)
        empty=DiscoveryCellIsEmpty(min+int3(x,y,z));
    _DiscoveryResults[id.x]=empty?1u:0u;
}

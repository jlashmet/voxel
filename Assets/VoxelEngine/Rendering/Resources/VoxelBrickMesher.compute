// GPU surface extraction for the voxel mirror.
//
// Three kernels in the order the plan's sizing strategy requires: sample the density field, count
// what each cell will emit, then write geometry into space reserved from those counts. Counting
// before writing is what lets a compute mesher bound its output at all — a shader cannot grow a
// buffer, and a partially written chunk is a hole rather than a saving.
//
// Nothing here reads back. The counts stay on the GPU for the prefix pass, and the geometry stays
// on the GPU through drawing, per the plan's no-readback invariant.

#pragma kernel CSSampleDensity
#pragma kernel CSBatchSampleDensity
#pragma kernel CSCountCells
#pragma kernel CSBatchCountCells
#pragma kernel CSCountFacetedFaces
#pragma kernel CSBatchCountFacetedFaces
#pragma kernel CSCountDecorations
#pragma kernel CSBatchCountDecorations
#pragma kernel CSBatchSampleFaces
#pragma kernel CSBatchCountTransitions
#pragma kernel CSBatchCountProfiles
#pragma kernel CSBatchWriteTransitions
#pragma kernel CSBatchWriteProfiles
#pragma kernel CSBatchPublishArgs
#pragma kernel CSWriteCells
#pragma kernel CSBatchWriteCells
#pragma kernel CSWriteFacetedFaces
#pragma kernel CSBatchWriteFacetedFaces
#pragma kernel CSWriteDecorations
#pragma kernel CSBatchWriteDecorations
#pragma kernel CSCopyVertices
#pragma kernel CSCopyIndices
#pragma kernel CSPublishArgs
#pragma kernel CSCopyCountersToBatch
#pragma kernel CSPrefixBatchCounts
#pragma kernel CSSampleFace
#pragma kernel CSTransitionCells

#include "VoxelBrickDensity.hlsl"

// -- meshed chunk ------------------------------------------------------------

int3 _ChunkOriginVoxel;
int _CellsPerAxis;
int _GridSize;
int _Padding;
int _SourceStep;
float _VoxelSize;

// -- sampled field -----------------------------------------------------------
//
// The same buffers are bound twice, once writable for the sampling kernel and once read-only for
// the kernels that consume them. A UAV is a scarcer resource than it looks — the floor across
// supported hardware is eight per kernel, and binding every buffer writable everywhere overran that
// on the write kernel. Reading through an SRV also lets the driver assume the data is immutable for
// the dispatch, which is true here and worth telling it.

RWStructuredBuffer<float> _DensityWrite;
RWStructuredBuffer<uint> _SampleMaterialWrite;
RWStructuredBuffer<uint> _SampleSurfaceWrite;
RWStructuredBuffer<uint> _SampleBoundaryWrite;

StructuredBuffer<float> _Density;
StructuredBuffer<uint> _SampleMaterial;
StructuredBuffer<uint> _SampleSurface;
StructuredBuffer<uint> _SampleBoundary;

// -- Transvoxel regular tables ----------------------------------------------

StructuredBuffer<uint> _RegularCellClass;        // 256 case codes -> class
StructuredBuffer<uint> _RegularGeometryCounts;   // per class: vertex/triangle counts
StructuredBuffer<uint> _RegularCellIndices;      // per class: 15 corner indices
StructuredBuffer<uint> _RegularEdgeCodes;        // per case: 12 edge codes

// -- output ------------------------------------------------------------------

RWStructuredBuffer<uint> _CellVertexCountsWrite;
RWStructuredBuffer<uint> _CellTriangleCountsWrite;
RWStructuredBuffer<uint> _CellReconstructionFlagsWrite;

StructuredBuffer<uint> _CellVertexCounts;
StructuredBuffer<uint> _CellTriangleCounts;
StructuredBuffer<uint> _CellReconstructionFlags;

struct SurfaceVertex
{
    float3 position;
    float3 normal;
    uint material;
    uint active;
};

RWStructuredBuffer<SurfaceVertex> _Vertices;
RWStructuredBuffer<uint> _Indices;

StructuredBuffer<SurfaceVertex> _CopyVerticesSource;
RWStructuredBuffer<SurfaceVertex> _CopyVerticesDestination;
StructuredBuffer<uint> _CopyIndicesSource;
RWStructuredBuffer<uint> _CopyIndicesDestination;
int _CopyVertexDestinationBase;
int _CopyIndexDestinationBase;
int _CopyVertexCount;
int _CopyIndexCount;
RWStructuredBuffer<uint> _DrawArgs;
int _DrawArgsWordStart;
// Write pass: 0,1 are vertices/indices written. Count pass: 2,3 are vertices/indices coming.
// During the sample/count half only, word 0 is also a boolean unsupported-semantics marker. The
// write path resets all counters before it starts, so the marker never enters geometry accounting.
RWStructuredBuffer<uint> _Counters;
RWStructuredBuffer<uint> _BatchCounters;
int _BatchCounterWordStart;
int _BatchRecordCount;
int _BatchVertexAlignment;
int _BatchIndexAlignment;
int _VertexCapacity;
int _IndexCapacity;

struct BatchChunkDescriptor
{
    int3 chunkOriginVoxel;
    int sourceStep;
    uint transitionFaceMask;
    float voxelSize;
    uint handle;
    uint generationLow;
    uint generationHigh;
    uint profileStart;
    uint profileCount;
};
StructuredBuffer<BatchChunkDescriptor> _BatchChunks;
struct GpuProfileBlock
{
    int3 centre;
    int innerRadiusQ4;
    int outerRadiusQ4;
    int frontQ4;
    int backQ4;
    int backingDepthVoxel;
    int2 startDirection;
    int2 endDirection;
    uint shape;
    uint surface;
    uint batch;
};
StructuredBuffer<BatchChunkDescriptor> _BatchChunks_UNUSED_DO_NOT_USE;
StructuredBuffer<GpuProfileBlock> _BatchProfiles;
int _BatchProfileCount;
RWStructuredBuffer<float> _BatchDensityWrite;
RWStructuredBuffer<uint> _BatchSampleMaterialWrite;
RWStructuredBuffer<uint> _BatchSampleSurfaceWrite;
RWStructuredBuffer<uint> _BatchSampleBoundaryWrite;
RWStructuredBuffer<uint> _BatchCellVertexCountsWrite;
RWStructuredBuffer<uint> _BatchCellTriangleCountsWrite;
RWStructuredBuffer<uint> _BatchCellReconstructionFlagsWrite;
RWStructuredBuffer<float> _BatchFaceDensityWrite;
RWStructuredBuffer<uint> _BatchFaceMaterialWrite;
RWStructuredBuffer<uint> _BatchFaceSurfaceWrite;
StructuredBuffer<float> _BatchDensity;
StructuredBuffer<uint> _BatchSampleMaterial;
StructuredBuffer<uint> _BatchSampleSurface;
StructuredBuffer<uint> _BatchSampleBoundary;
StructuredBuffer<uint> _BatchCellVertexCounts;
StructuredBuffer<uint> _BatchCellTriangleCounts;
StructuredBuffer<uint> _BatchCellReconstructionFlags;
StructuredBuffer<float> _BatchFaceDensity;
StructuredBuffer<uint> _BatchFaceMaterial;
StructuredBuffer<uint> _BatchFaceSurface;
RWStructuredBuffer<SurfaceVertex> _BatchVertices;
RWStructuredBuffer<uint> _BatchIndices;
RWStructuredBuffer<uint> _BatchDrawArgs;
int _BatchVertexDestinationBase;
int _BatchIndexDestinationBase;
int _BatchArgsWordStart;
int _BatchPagedOutput;
int _BatchVertexPageSize;
int _BatchIndexPageSize;
int _BatchMaxVertexPagesPerChunk;
int _BatchMaxIndexPagesPerChunk;
StructuredBuffer<uint> _BatchVertexPageTable;
StructuredBuffer<uint> _BatchIndexPageTable;

// -- page indirection ---------------------------------------------------------

StructuredBuffer<uint> _ChunkPages;
int _VerticesPerPage;
int _IndicesPerPage;
int _VertexWriteBase;
int _IndexWriteBase;

// 1 while counting: emit nothing, just accumulate what would be emitted.
int _TransitionCountOnly;

uint ArenaVertex(uint local)
{
    uint page = _ChunkPages[local / (uint)_VerticesPerPage];
    return page * (uint)_VerticesPerPage + local % (uint)_VerticesPerPage;
}

uint VertexSlot(uint local) { return (uint)_VertexWriteBase + ArenaVertex(local); }

uint ArenaIndexSlot(uint local)
{
    uint page = _ChunkPages[local / (uint)_IndicesPerPage];
    return (uint)_IndexWriteBase + page * (uint)_IndicesPerPage + local % (uint)_IndicesPerPage;
}

int GridIndex(int3 g) { return g.x + _GridSize * (g.y + _GridSize * g.z); }
int RegularCellAxis() { return _CellsPerAxis + 1; }
int BatchSampleCount() { return _GridSize * _GridSize * _GridSize; }
int BatchSampleIndex(uint batch, int3 g) { return (int)batch * BatchSampleCount() + GridIndex(g); }
int BatchRegularCellCount()
{
    int axis = RegularCellAxis();
    return axis * axis * axis;
}
int BatchCellIndex(uint batch, int cell) { return (int)batch * BatchRegularCellCount() + cell; }
int BatchRecordWord(uint batch) { return 4 + (int)batch * 17; }

// Transvoxel corner numbering: x is bit 0, y is bit 2 and z is bit 1.
int3 CellCorner(int i)
{
    return int3(i & 1, (i >> 2) & 1, (i >> 1) & 1);
}

int3 RegularCellFromIndex(int cellIndex)
{
    int axis = RegularCellAxis();
    int x = cellIndex % axis;
    int y = (cellIndex / axis) % axis;
    int z = cellIndex / (axis * axis);
    return int3(x - 1, y - 1, z - 1);
}

bool OwnsSelectedInsideSample(int3 cell, int selectedInsideCorner)
{
    if (selectedInsideCorner < 0 || selectedInsideCorner >= 8) return false;
    int3 sample = cell + CellCorner(selectedInsideCorner);
    return all(sample >= 0) && all(sample < _CellsPerAxis);
}

int ProfileAxis(GpuProfileBlock block) { return (int)(block.shape & 0xFFu); }
uint ProfileMaterial(GpuProfileBlock block) { return (block.shape >> 8) & 0xFFu; }

bool ProfileOwnsTriangle(GpuProfileBlock block, float3 a, float3 b, float3 c,
                         uint material)
{
    if (material != ProfileMaterial(block)) return false;
    int axis = ProfileAxis(block);
    int axisA = (axis + 1) % 3;
    int axisB = (axis + 2) % 3;
    float inner = block.innerRadiusQ4 * (1.0 / 16.0);
    float outer = block.outerRadiusQ4 * (1.0 / 16.0);
    float front = min(block.frontQ4, block.backQ4) * (1.0 / 16.0);
    float back = max(block.frontQ4, block.backQ4) * (1.0 / 16.0);
    float3 triangleCentre = (a + b + c) * (1.0 / 3.0);
    float da = triangleCentre[axisA] - block.centre[axisA];
    float db = triangleCentre[axisB] - block.centre[axisB];
    const float Padding = 0.55;
    if (abs(da) > outer + Padding || abs(db) > outer + Padding
     || triangleCentre[axis] < front - Padding || triangleCentre[axis] > back + Padding)
        return false;
    float radius = sqrt(da * da + db * db);
    if (radius < inner - Padding || radius > outer + Padding) return false;
    float start = atan2((float)block.startDirection.y, (float)block.startDirection.x);
    float finish = atan2((float)block.endDirection.y, (float)block.endDirection.x);
    const float TwoPi = 6.28318530717958647692;
    if (finish <= start) finish += TwoPi;
    float angle = atan2(db, da);
    while (angle < start) angle += TwoPi;
    return angle >= start && angle <= finish;
}

bool BatchProfileOwnsTriangle(uint batch, float3 a, float3 b, float3 c,
                              uint material)
{
    BatchChunkDescriptor chunk = _BatchChunks[batch];
    for (uint i = 0u; i < chunk.profileCount; i++)
        if (ProfileOwnsTriangle(_BatchProfiles[chunk.profileStart + i], a, b, c, material))
            return true;
    return false;
}

uint BatchProfileSuppressionMask(uint batch, int3 cell, uint caseCode, uint cellClass,
                                 uint sourceVertexCount, uint sourceIndexCount)
{
    if (_BatchChunks[batch].profileCount == 0u) return 0u;
    float density[8];
    uint material[8];
    uint boundary[8];
    for (int i = 0; i < 8; i++)
    {
        int sample = BatchSampleIndex(batch, cell + _Padding + CellCorner(i));
        density[i] = _BatchDensity[sample];
        material[i] = _BatchSampleMaterial[sample];
        boundary[i] = _BatchSampleBoundary[sample];
    }

    float3 positions[15];
    uint materials[15];
    BatchChunkDescriptor chunk = _BatchChunks[batch];
    for (uint v = 0u; v < sourceVertexCount; v++)
    {
        uint edge = _RegularEdgeCodes[caseCode * 12u + v];
        int c0 = (int)((edge >> 4) & 0x0Fu);
        int c1 = (int)(edge & 0x0Fu);
        float d0 = density[c0], d1 = density[c1];
        int3 o0 = CellCorner(c0), o1 = CellCorner(c1);
        int3 delta = abs(o1 - o0);
        int edgeAxis = delta.x != 0 ? 0 : (delta.y != 0 ? 1 : 2);
        if ((BoundaryIsAuthored(boundary[c0]) && !BoundaryAppliesAlong(boundary[c0], edgeAxis))
         || (BoundaryIsAuthored(boundary[c1]) && !BoundaryAppliesAlong(boundary[c1], edgeAxis)))
        {
            d0 = IsSolidSample(material[c0]) ? 0.5 : -0.5;
            d1 = IsSolidSample(material[c1]) ? 0.5 : -0.5;
        }
        float t0 = abs(d1 - d0) > 1e-7 ? d1 / (d1 - d0) : 0.5;
        float t1 = 1.0 - t0;
        positions[v] = (float3)chunk.chunkOriginVoxel
                     + ((float3)(cell + o0) * t0 + (float3)(cell + o1) * t1)
                       * chunk.sourceStep + 0.5;
        int selected = d0 > d1 ? c0 : c1;
        uint chosen = material[selected];
        if (!IsSolidSample(chosen))
        {
            for (int corner = 0; corner < 8; corner++)
                if (IsSolidSample(material[corner])) { chosen = material[corner]; break; }
        }
        materials[v] = chosen;
    }

    uint suppressed = 0u;
    uint tableBase = cellClass * 15u;
    for (uint t = 0u; t < sourceIndexCount; t += 3u)
    {
        uint i0 = _RegularCellIndices[tableBase + t];
        uint i1 = _RegularCellIndices[tableBase + t + 1u];
        uint i2 = _RegularCellIndices[tableBase + t + 2u];
        if (materials[i0] == materials[i1] && materials[i0] == materials[i2]
         && BatchProfileOwnsTriangle(batch, positions[i0], positions[i1], positions[i2],
                                    materials[i0]))
            suppressed |= 1u << (t / 3u);
    }
    return suppressed;
}

[numthreads(64, 1, 1)]
void CSSampleDensity(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    int total = _GridSize * _GridSize * _GridSize;
    if (index >= total) return;

    int gx = index % _GridSize;
    int yz = index / _GridSize;
    int gy = yz % _GridSize;
    int gz = yz / _GridSize;
    int3 p = _ChunkOriginVoxel + (int3(gx, gy, gz) - _Padding) * _SourceStep;
    uint material, surface, boundary;
    float density = SampleField(p, _SourceStep, material, surface, boundary);
    _DensityWrite[index] = density;
    _SampleMaterialWrite[index] = material;
    _SampleSurfaceWrite[index] = surface;
    _SampleBoundaryWrite[index] = boundary;
}

[numthreads(64, 1, 1)]
void CSBatchSampleDensity(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    int total = BatchSampleCount();
    if (index >= total) return;
    BatchChunkDescriptor chunk = _BatchChunks[id.y];
    int gx = index % _GridSize;
    int yz = index / _GridSize;
    int gy = yz % _GridSize;
    int gz = yz / _GridSize;
    int3 p = chunk.chunkOriginVoxel + (int3(gx, gy, gz) - _Padding) * chunk.sourceStep;
    uint material, surface, boundary;
    int output = (int)id.y * total + index;
    float density = SampleField(p, chunk.sourceStep, material, surface, boundary);
    _BatchDensityWrite[output] = density;
    _BatchSampleMaterialWrite[output] = material;
    _BatchSampleSurfaceWrite[output] = surface;
    _BatchSampleBoundaryWrite[output] = boundary;
}

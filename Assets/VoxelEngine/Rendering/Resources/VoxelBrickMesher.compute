// GPU surface extraction for the voxel mirror.
//
// Three kernels in the order the plan's sizing strategy requires: sample the density field, count
// what each cell will emit, then write geometry into space reserved from those counts. Counting
// before writing is what lets a compute mesher bound its output at all — a shader cannot grow a
// buffer, and a partially written chunk is a hole rather than a saving.
//
// Nothing here reads back. The counts stay on the GPU for the prefix pass, and the geometry stays
// on the GPU through drawing, per the plan's no-readback invariant.

#pragma kernel CSSampleDensity
#pragma kernel CSCountCells
#pragma kernel CSCountFacetedFaces
#pragma kernel CSCountDecorations
#pragma kernel CSWriteCells
#pragma kernel CSWriteFacetedFaces
#pragma kernel CSWriteDecorations
#pragma kernel CSCopyVertices
#pragma kernel CSCopyIndices
#pragma kernel CSPublishArgs
#pragma kernel CSCopyCountersToBatch
#pragma kernel CSPrefixBatchCounts
#pragma kernel CSSampleFace
#pragma kernel CSTransitionCells

#include "VoxelBrickDensity.hlsl"

// -- meshed chunk ------------------------------------------------------------

int3 _ChunkOriginVoxel;
int _CellsPerAxis;
int _GridSize;
int _Padding;
int _SourceStep;
float _VoxelSize;

// -- sampled field -----------------------------------------------------------
//
// The same buffers are bound twice, once writable for the sampling kernel and once read-only for
// the kernels that consume them. A UAV is a scarcer resource than it looks — the floor across
// supported hardware is eight per kernel, and binding every buffer writable everywhere overran that
// on the write kernel. Reading through an SRV also lets the driver assume the data is immutable for
// the dispatch, which is true here and worth telling it.

RWStructuredBuffer<float> _DensityWrite;
RWStructuredBuffer<uint> _SampleMaterialWrite;
RWStructuredBuffer<uint> _SampleSurfaceWrite;
RWStructuredBuffer<uint> _SampleBoundaryWrite;

StructuredBuffer<float> _Density;
StructuredBuffer<uint> _SampleMaterial;
StructuredBuffer<uint> _SampleSurface;
StructuredBuffer<uint> _SampleBoundary;

// -- Transvoxel regular tables ----------------------------------------------

StructuredBuffer<uint> _RegularCellClass;        // 256 case codes -> class
StructuredBuffer<uint> _RegularGeometryCounts;   // per class: vertex/triangle counts
StructuredBuffer<uint> _RegularCellIndices;      // per class: 15 corner indices
StructuredBuffer<uint> _RegularEdgeCodes;        // per case: 12 edge codes

// -- output ------------------------------------------------------------------

RWStructuredBuffer<uint> _CellVertexCountsWrite;
RWStructuredBuffer<uint> _CellTriangleCountsWrite;

StructuredBuffer<uint> _CellVertexCounts;
StructuredBuffer<uint> _CellTriangleCounts;

struct SurfaceVertex
{
    float3 position;
    float3 normal;
    uint material;
    uint active;
};

RWStructuredBuffer<SurfaceVertex> _Vertices;
RWStructuredBuffer<uint> _Indices;

StructuredBuffer<SurfaceVertex> _CopyVerticesSource;
RWStructuredBuffer<SurfaceVertex> _CopyVerticesDestination;
StructuredBuffer<uint> _CopyIndicesSource;
RWStructuredBuffer<uint> _CopyIndicesDestination;
int _CopyVertexDestinationBase;
int _CopyIndexDestinationBase;
int _CopyVertexCount;
int _CopyIndexCount;
RWStructuredBuffer<uint> _DrawArgs;
int _DrawArgsWordStart;
// Write pass: 0,1 are vertices/indices written. Count pass: 2,3 are vertices/indices coming.
// During the sample/count half only, word 0 is also a boolean unsupported-semantics marker. The
// write path resets all counters before it starts, so the marker never enters geometry accounting.
RWStructuredBuffer<uint> _Counters;
RWStructuredBuffer<uint> _BatchCounters;
int _BatchCounterWordStart;
int _BatchRecordCount;
int _BatchVertexAlignment;
int _BatchIndexAlignment;
int _VertexCapacity;
int _IndexCapacity;

// -- page indirection ---------------------------------------------------------

StructuredBuffer<uint> _ChunkPages;
int _VerticesPerPage;
int _IndicesPerPage;
int _VertexWriteBase;
int _IndexWriteBase;

// 1 while counting: emit nothing, just accumulate what would be emitted.
int _TransitionCountOnly;

uint ArenaVertex(uint local)
{
    uint page = _ChunkPages[local / (uint)_VerticesPerPage];
    return page * (uint)_VerticesPerPage + local % (uint)_VerticesPerPage;
}

uint VertexSlot(uint local) { return (uint)_VertexWriteBase + ArenaVertex(local); }

uint ArenaIndexSlot(uint local)
{
    uint page = _ChunkPages[local / (uint)_IndicesPerPage];
    return (uint)_IndexWriteBase + page * (uint)_IndicesPerPage + local % (uint)_IndicesPerPage;
}

int GridIndex(int3 g) { return g.x + _GridSize * (g.y + _GridSize * g.z); }

// Transvoxel corner numbering: x is bit 0, y is bit 2 and z is bit 1.
int3 CellCorner(int i)
{
    return int3(i & 1, (i >> 2) & 1, (i >> 1) & 1);
}

int RegularCellAxis() { return _CellsPerAxis + 1; }

int3 RegularCellFromIndex(int cellIndex)
{
    int axis = RegularCellAxis();
    int x = cellIndex % axis;
    int y = (cellIndex / axis) % axis;
    int z = cellIndex / (axis * axis);
    return int3(x - 1, y - 1, z - 1);
}

bool OwnsSelectedInsideSample(int3 cell, int selectedInsideCorner)
{
    if (selectedInsideCorner < 0 || selectedInsideCorner >= 8) return false;
    int3 sample = cell + CellCorner(selectedInsideCorner);
    return all(sample >= 0) && all(sample < _CellsPerAxis);
}

// ---------------------------------------------------------------------------
// 1. Sample the density field over the padded grid.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void CSSampleDensity(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    int total = _GridSize * _GridSize * _GridSize;
    if (index >= total) return;

    int gx = index % _GridSize;
    int yz = index / _GridSize;
    int gy = yz % _GridSize;
    int gz = yz / _GridSize;

    int3 p = _ChunkOriginVoxel + (int3(gx, gy, gz) - _Padding) * _SourceStep;

    uint material, surface, boundary;
    _DensityWrite[index] = SampleField(p, _SourceStep, material, surface, boundary);
    _SampleMaterialWrite[index] = material;
    _SampleSurfaceWrite[index] = surface;
    _SampleBoundaryWrite[index] = boundary;
}

// ---------------------------------------------------------------------------
// 2. Count what each cell emits, without emitting it.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void CSCountCells(uint3 id : SV_DispatchThreadID)
{
    int cellIndex = (int)id.x;
    int axis = RegularCellAxis();
    int cellTotal = axis * axis * axis;
    if (cellIndex >= cellTotal) return;

    // Always clear the per-cell buffers first. Blocking verification paths may still dispatch the
    // write kernel after a rejected count, and stale counts from a previous chunk must never write.
    _CellVertexCountsWrite[cellIndex] = 0u;
    _CellTriangleCountsWrite[cellIndex] = 0u;
    if (_Counters[0] != 0u) return;

    int3 cell = RegularCellFromIndex(cellIndex);

    uint caseCode = 0u;
    int selectedInsideCorner = -1;
    for (int i = 0; i < 8; i++)
    {
        int3 g = cell + _Padding + CellCorner(i);
        float sampleDensity = _Density[GridIndex(g)];
        if (sampleDensity < 0.0) caseCode |= 1u << (uint)i;
        else if (selectedInsideCorner < 0) selectedInsideCorner = i;
    }

    if (caseCode == 0u || caseCode == 255u) return;
    if (!OwnsSelectedInsideSample(cell, selectedInsideCorner)) return;

    bool continuous = false, planar = false, rounded = false;
    bool authoredBoundary = false, displacedCoating = false;
    for (int metadataCorner = 0; metadataCorner < 8; metadataCorner++)
    {
        int metadataSample = GridIndex(cell + _Padding + CellCorner(metadataCorner));
        uint metadataSurface = _SampleSurface[metadataSample];
        authoredBoundary = authoredBoundary || BoundaryIsAuthored(_SampleBoundary[metadataSample]);
        displacedCoating = displacedCoating || CoatingDisplacement(metadataSurface) != 0.0;
    }
    for (int c = 0; c < 8; c++)
    {
        int3 g = cell + _Padding + CellCorner(c);
        int sample = GridIndex(g);
        if (!IsSolidSample(_SampleMaterial[sample])) continue;
        StyleDefinition style = LoadStyle(_SampleSurface[sample] & 0xFFFFu);
        bool isContinuous = style.reconstruction == RECONSTRUCTION_SMOOTH
                         || style.reconstruction == RECONSTRUCTION_ROUNDED
                         || (style.reconstruction == RECONSTRUCTION_PLANAR
                             && (authoredBoundary || displacedCoating));
        if (!isContinuous) continue;
        continuous = true;
        if (style.reconstruction == RECONSTRUCTION_PLANAR) planar = true;
        else rounded = true;
    }
    if (!continuous) return;

    uint cellClass = _RegularCellClass[caseCode];
    uint counts = _RegularGeometryCounts[cellClass];
    uint sourceVertexCount = counts >> 4;
    uint indexCount = (counts & 0x0Fu) * 3u;

    uint outputVertexCount = (planar && !rounded) ? indexCount : sourceVertexCount;
    if (outputVertexCount > 15u || indexCount > 15u) return;

    _CellVertexCountsWrite[cellIndex] = outputVertexCount;
    _CellTriangleCountsWrite[cellIndex] = indexCount / 3u;

    uint ignored;
    InterlockedAdd(_Counters[2], outputVertexCount, ignored);
    InterlockedAdd(_Counters[3], indexCount, ignored);
}

// ---------------------------------------------------------------------------
// 2b. Exact Planar/Sharp/Cubic faces. Each thread owns one cell face. This deliberately emits
// one quad per exposed cell rather than serially greedy-merging a plane: it keeps all 6*N^3 tests
// parallel and preserves the exact occupied boundary, material, normal and winding semantics.
// ---------------------------------------------------------------------------

int3 FacetedCellFromIndex(int cellIndex)
{
    int plane = _CellsPerAxis * _CellsPerAxis;
    return int3(cellIndex % _CellsPerAxis,
                (cellIndex / _CellsPerAxis) % _CellsPerAxis,
                cellIndex / plane);
}

uint PackMaterial(uint material, uint surface);

float3 AxisOffset(int axis, float amount)
{
    return axis == 0 ? float3(amount, 0.0, 0.0)
         : axis == 1 ? float3(0.0, amount, 0.0)
                     : float3(0.0, 0.0, amount);
}

int3 AxisOffsetInt(int axis, int amount)
{
    return axis == 0 ? int3(amount, 0, 0)
         : axis == 1 ? int3(0, amount, 0)
                     : int3(0, 0, amount);
}

int AxisComponent(int3 value, int axis)
{
    return axis == 0 ? value.x : (axis == 1 ? value.y : value.z);
}

bool ClassifyFacetedCell(int cellIndex, out int3 voxel, out uint attributes,
                         out uint boundary, out uint reconstruction, out bool displaced)
{
    int cellTotal = _CellsPerAxis * _CellsPerAxis * _CellsPerAxis;
    voxel = 0; attributes = boundary = reconstruction = 0u; displaced = false;
    if (cellIndex >= cellTotal) return false;

    int3 local = FacetedCellFromIndex(cellIndex);
    voxel = _ChunkOriginVoxel + local * _SourceStep;
    uint surface;
    uint material = ReadMaterial(voxel, surface, boundary);
    if (!IsSolidSample(material)) return false;
    surface = ResolveSurface(material, surface);
    StyleDefinition style = LoadStyle(surface & 0xFFFFu);
    bool materialBlend = IsMaterialBlendSurface(surface);
    displaced = !materialBlend && CoatingDisplacement(surface) != 0.0;
    reconstruction = style.reconstruction;
    attributes = PackMaterial(material, surface);
    return reconstruction == RECONSTRUCTION_PLANAR
        || reconstruction == RECONSTRUCTION_SHARP
        || reconstruction == RECONSTRUCTION_CUBIC;
}

bool FacetedFaceExposed(int3 voxel, uint boundary, uint reconstruction, bool displaced,
                        int face, out int axis, out int sign)
{
    axis = face >> 1;
    sign = (face & 1) == 0 ? -1 : 1;
    if (reconstruction == RECONSTRUCTION_PLANAR
        && (BoundaryAppliesAlong(boundary, axis) || displaced)) return false;
    int3 neighbour = voxel + AxisOffsetInt(axis, sign * _SourceStep);
    uint adjacentSurface, adjacentBoundary;
    if (IsSolidSample(ReadMaterial(neighbour, adjacentSurface, adjacentBoundary))) return false;
    return true;
}

[numthreads(64, 1, 1)]
void CSCountFacetedFaces(uint3 id : SV_DispatchThreadID)
{
    if (_Counters[0] != 0u) return;
    int3 voxel; uint attributes,boundary,reconstruction; bool displaced;
    if (!ClassifyFacetedCell((int)id.x,voxel,attributes,boundary,reconstruction,displaced)) return;
    uint faceCount=0u;
    for(int face=0;face<6;face++)
    {
        int axis,sign;
        if(FacetedFaceExposed(voxel,boundary,reconstruction,displaced,face,axis,sign)) faceCount++;
    }
    if(faceCount==0u) return;
    uint ignored;
    InterlockedAdd(_Counters[2], faceCount*4u, ignored);
    InterlockedAdd(_Counters[3], faceCount*6u, ignored);
}

void StoreVertex(uint localIndex, float3 position, float3 normal, uint attributes)
{
    SurfaceVertex vertex;
    vertex.position = position * _VoxelSize;
    vertex.normal = normal;
    vertex.material = attributes;
    vertex.active = 0x0000FF00u;
    _Vertices[VertexSlot(localIndex)] = vertex;
}

void StoreQuadIndices(uint vertexBase, uint indexBase, bool flip)
{
    if (flip)
    {
        _Indices[ArenaIndexSlot(indexBase+0u)]=ArenaVertex(vertexBase+0u);
        _Indices[ArenaIndexSlot(indexBase+1u)]=ArenaVertex(vertexBase+2u);
        _Indices[ArenaIndexSlot(indexBase+2u)]=ArenaVertex(vertexBase+1u);
        _Indices[ArenaIndexSlot(indexBase+3u)]=ArenaVertex(vertexBase+0u);
        _Indices[ArenaIndexSlot(indexBase+4u)]=ArenaVertex(vertexBase+3u);
        _Indices[ArenaIndexSlot(indexBase+5u)]=ArenaVertex(vertexBase+2u);
    }
    else
    {
        _Indices[ArenaIndexSlot(indexBase+0u)]=ArenaVertex(vertexBase+0u);
        _Indices[ArenaIndexSlot(indexBase+1u)]=ArenaVertex(vertexBase+1u);
        _Indices[ArenaIndexSlot(indexBase+2u)]=ArenaVertex(vertexBase+2u);
        _Indices[ArenaIndexSlot(indexBase+3u)]=ArenaVertex(vertexBase+0u);
        _Indices[ArenaIndexSlot(indexBase+4u)]=ArenaVertex(vertexBase+2u);
        _Indices[ArenaIndexSlot(indexBase+5u)]=ArenaVertex(vertexBase+3u);
    }
}

[numthreads(64, 1, 1)]
void CSWriteFacetedFaces(uint3 id : SV_DispatchThreadID)
{
    int3 voxel; uint attributes,boundary,reconstruction; bool displaced;
    if (!ClassifyFacetedCell((int)id.x,voxel,attributes,boundary,reconstruction,displaced)) return;
    uint faceMask=0u,faceCount=0u;
    for(int classifiedFace=0;classifiedFace<6;classifiedFace++)
    {
        int classifiedAxis,classifiedSign;
        if(!FacetedFaceExposed(voxel,boundary,reconstruction,displaced,classifiedFace,
                              classifiedAxis,classifiedSign)) continue;
        faceMask|=1u<<classifiedFace; faceCount++;
    }
    if(faceCount==0u) return;
    uint vertexBase, indexBase;
    InterlockedAdd(_Counters[0], faceCount*4u, vertexBase);
    InterlockedAdd(_Counters[1], faceCount*6u, indexBase);
    if ((int)(vertexBase + faceCount*4u) > _VertexCapacity
     || (int)(indexBase + faceCount*6u) > _IndexCapacity) return;
    uint emitted=0u;
    for(int face=0;face<6;face++)
    {
        if((faceMask&(1u<<face))==0u) continue;
        int axis=face>>1,sign=(face&1)==0?-1:1;
        int axisA=(axis+1)%3,axisB=(axis+2)%3;
        float3 p0=(float3)voxel+AxisOffset(axis,sign>0?_SourceStep:0);
        float3 p1=p0+AxisOffset(axisA,_SourceStep);
        float3 p2=p1+AxisOffset(axisB,_SourceStep);
        float3 p3=p0+AxisOffset(axisB,_SourceStep);
        float3 normal=AxisOffset(axis,sign);
        uint vb=vertexBase+emitted*4u,ib=indexBase+emitted*6u;
        StoreVertex(vb+0u,p0,normal,attributes); StoreVertex(vb+1u,p1,normal,attributes);
        StoreVertex(vb+2u,p2,normal,attributes); StoreVertex(vb+3u,p3,normal,attributes);
        StoreQuadIndices(vb,ib,dot(cross(p1-p0,p2-p0),normal)<0.0);
        emitted++;
    }
}

// ---------------------------------------------------------------------------
// 2c. Deterministic coating decorations. Classification is repeated in count and write so no
// surface-sized CPU transfer or serialized compaction pass is introduced.
// ---------------------------------------------------------------------------

uint DecorationHash(int3 voxel, uint coating)
{
    uint h = asuint(voxel.x) * 0x9E3779B9u ^ asuint(voxel.y) * 0x85EBCA6Bu
           ^ asuint(voxel.z) * 0xC2B2AE35u ^ coating * 0x27D4EB2Fu;
    h ^= h >> 16; h *= 0x7FEB352Du; h ^= h >> 15;
    return h;
}

int FloorModDecoration(int value, int divisor)
{
    int remainder = value % divisor;
    return remainder < 0 ? remainder + divisor : remainder;
}

bool DecorationAnchor(int3 voxel, uint coating, int face, uint separation, uint hash)
{
    if (separation == 0u) return true;
    int stride = (int)separation + 1;
    int axis = face >> 1;
    int axisA = (axis + 1) % 3;
    int axisB = (axis + 2) % 3;
    int offsetA = (int)(hash % (uint)stride);
    int offsetB = (int)((hash >> 8) % (uint)stride);
    return FloorModDecoration(AxisComponent(voxel,axisA)+offsetA,stride)==0
        && FloorModDecoration(AxisComponent(voxel,axisB)+offsetB,stride)==0;
}

bool LoadDecorationCell(int cellIndex, out int3 voxel, out uint material, out uint surface,
                        out uint coating, out uint coatingWord1, out uint coatingWord2)
{
    int cellTotal = _CellsPerAxis * _CellsPerAxis * _CellsPerAxis;
    voxel=0; material=surface=coating=coatingWord1=coatingWord2=0u;
    if (cellIndex >= cellTotal) return false;
    voxel = _ChunkOriginVoxel + FacetedCellFromIndex(cellIndex); // CPU decorations are LOD0 cells.
    uint boundary;
    material = ReadMaterial(voxel, surface, boundary);
    if (!IsSolidSample(material) || IsMaterialBlendSurface(surface)) return false;
    coating = (surface >> 16) & 0xFFu;
    coatingWord1 = _CoatingWords[coating * COATING_WORDS + 1u];
    coatingWord2 = _CoatingWords[coating * COATING_WORDS + 2u];
    uint shape = (coatingWord1 >> 8) & 0xFFu;
    uint density = (coatingWord1 >> 16) & 0xFFu;
    return shape == 1u && density != 0u;
}

bool ClassifyDecorationFace(int3 voxel, uint coating, uint coatingWord1, uint coatingWord2,
                            int face, out int axis, out int sign, out uint hash,
                            out uint fringeMask)
{
    axis=sign=0; hash=fringeMask=0u;
    uint density = (coatingWord1 >> 16) & 0xFFu;
    uint faceMask = coatingWord2 >> 24;
    if ((faceMask & (1u << face)) == 0u) return false;
    axis = face >> 1; sign = (face & 1) == 0 ? -1 : 1;
    int3 neighbour = voxel + AxisOffsetInt(axis,sign);
    uint adjacentSurface, adjacentBoundary;
    if (IsSolidSample(ReadMaterial(neighbour, adjacentSurface, adjacentBoundary))) return false;
    hash = DecorationHash(voxel, coating + (uint)face * 17u);
    if ((hash & 0xFFu) >= density) return false;
    uint separation = (coatingWord2 >> 16) & 0xFFu;
    if (!DecorationAnchor(voxel, coating, face, separation, hash)) return false;

    uint dropQ4 = (coatingWord2 >> 8) & 0xFFu;
    if (axis == 1 && sign > 0 && dropQ4 > 0u)
    {
        for (int sideFace = 0; sideFace < 6; sideFace++)
        {
            int sideAxis = sideFace >> 1;
            if (sideAxis == 1) continue;
            int sideSign = (sideFace & 1) == 0 ? -1 : 1;
            int3 sideNeighbour = voxel + AxisOffsetInt(sideAxis,sideSign);
            if (!IsSolidSample(ReadMaterial(sideNeighbour, adjacentSurface, adjacentBoundary)))
                fringeMask |= 1u << sideFace;
        }
    }
    return true;
}

uint CountBits4(uint mask)
{
    mask = mask - ((mask >> 1) & 0x55555555u);
    mask = (mask & 0x33333333u) + ((mask >> 2) & 0x33333333u);
    return ((mask + (mask >> 4)) & 0x0F0F0F0Fu) % 255u;
}

[numthreads(64, 1, 1)]
void CSCountDecorations(uint3 id : SV_DispatchThreadID)
{
    if (_Counters[0] != 0u) return;
    int3 voxel; uint material,surface,coating,word1,word2;
    if(!LoadDecorationCell((int)id.x,voxel,material,surface,coating,word1,word2)) return;
    uint vertexCount=0u,indexCount=0u;
    for(int face=0;face<6;face++)
    {
        int axis,sign; uint hash,fringes;
        if(!ClassifyDecorationFace(voxel,coating,word1,word2,face,axis,sign,hash,fringes)) continue;
        uint fringeCount=CountBits4(fringes);
        vertexCount+=12u+fringeCount*4u;
        indexCount+=48u+fringeCount*6u;
    }
    if(vertexCount==0u) return;
    uint ignored;
    InterlockedAdd(_Counters[2],vertexCount,ignored);
    InterlockedAdd(_Counters[3],indexCount,ignored);
}

void StoreDecorationVertex(uint localIndex, float3 position, float3 normal, uint attributes)
{
    StoreVertex(localIndex, position, normalize(normal), attributes);
}

void WriteDecorationFringe(float3 centre, int axisA, int axisB,
                           float radiusA, float radiusB, float maxDrop,
                           uint hash, int direction, uint attributes,
                           uint vertexBase, uint indexBase)
{
    float3 tangent, outward;
    if (direction < 2)
    {
        tangent=AxisOffset(axisA,1.0);
        outward=AxisOffset(axisB,direction==0?1.0:-1.0);
    }
    else
    {
        tangent=AxisOffset(axisB,1.0);
        outward=AxisOffset(axisA,direction==2?1.0:-1.0);
    }
    float halfWidth = lerp(0.20, 0.42, ((hash >> 3) & 0xFFu) / 255.0)
                    * (direction < 2 ? radiusA : radiusB);
    float drop = maxDrop * lerp(0.38, 1.0, ((hash >> 11) & 0xFFu) / 255.0);
    float outwardRadius = direction < 2 ? radiusB : radiusA;
    float3 lip = centre + outward * outwardRadius;
    float3 p0 = lip - tangent * halfWidth;
    float3 p1 = lip + tangent * halfWidth;
    float3 p2 = p1 - float3(0.0, drop, 0.0) - outward * 0.07;
    float3 p3 = p0 - float3(0.0, drop * 0.72, 0.0) - outward * 0.05;
    StoreDecorationVertex(vertexBase+0u,p0,outward,attributes);
    StoreDecorationVertex(vertexBase+1u,p1,outward,attributes);
    StoreDecorationVertex(vertexBase+2u,p2,outward,attributes);
    StoreDecorationVertex(vertexBase+3u,p3,outward,attributes);
    bool flip = dot(cross(p1-p0,p2-p0),outward) < 0.0;
    StoreQuadIndices(vertexBase,indexBase,flip);
}

void WriteDecorationFace(int3 voxel,uint material,uint surface,uint word1,uint word2,
                         int axis,int sign,uint hash,uint fringes)
{
    uint fringeCount = CountBits4(fringes);
    uint vertexCount = 12u + fringeCount * 4u;
    uint indexCount = 48u + fringeCount * 6u;
    uint vertexBase,indexBase;
    InterlockedAdd(_Counters[0],vertexCount,vertexBase);
    InterlockedAdd(_Counters[1],indexCount,indexBase);
    if ((int)(vertexBase+vertexCount)>_VertexCapacity || (int)(indexBase+indexCount)>_IndexCapacity) return;

    int axisA=(axis+1)%3, axisB=(axis+2)%3;
    float jitterA=(((hash>>8)&0xFFu)/255.0-0.5)*0.42;
    float jitterB=(((hash>>16)&0xFFu)/255.0-0.5)*0.42;
    float radiusQ4=(word1>>24)&0xFFu;
    float radiusA=radiusQ4*(1.0/16.0)*lerp(0.85,1.18,((hash>>5)&0xFFu)/255.0);
    float radiusB=radiusQ4*(1.0/16.0)*lerp(0.62,1.05,((hash>>13)&0xFFu)/255.0);
    float height=(word2&0xFFu)*(1.0/16.0)*lerp(0.78,1.22,((hash>>24)&0xFFu)/255.0);
    float3 centre=(float3)voxel+0.5
        +AxisOffset(axis,(sign>0?0.5:-0.5))
        +AxisOffset(axisA,jitterA)+AxisOffset(axisB,jitterB);
    uint attributes=PackMaterial(material,surface);
    const uint sides=6u;
    for(uint ring=0u;ring<2u;ring++)
    {
        float scale=ring==0u?1.0:0.94;
        float normalOffset=ring==0u?0.025:height;
        for(uint side=0u;side<sides;side++)
        {
            float angle=(side+((hash>>(side+3u))&7u)*0.018)*(6.28318530718/sides);
            float3 position=centre
                +AxisOffset(axisA,cos(angle)*radiusA*scale)
                +AxisOffset(axisB,sin(angle)*radiusB*scale)
                +AxisOffset(axis,normalOffset*sign);
            float3 normal=AxisOffset(axis,sign);
            StoreDecorationVertex(vertexBase+ring*sides+side,position,normal,attributes);
        }
    }
    for(uint side=0u;side<sides;side++)
    {
        uint next=(side+1u)%sides;
        uint o=indexBase+side*6u;
        _Indices[ArenaIndexSlot(o+0u)]=ArenaVertex(vertexBase+side);
        _Indices[ArenaIndexSlot(o+1u)]=ArenaVertex(vertexBase+sides+side);
        _Indices[ArenaIndexSlot(o+2u)]=ArenaVertex(vertexBase+next);
        _Indices[ArenaIndexSlot(o+3u)]=ArenaVertex(vertexBase+next);
        _Indices[ArenaIndexSlot(o+4u)]=ArenaVertex(vertexBase+sides+side);
        _Indices[ArenaIndexSlot(o+5u)]=ArenaVertex(vertexBase+sides+next);
    }
    uint topBase=indexBase+36u;
    for(uint topSide=1u;topSide<sides-1u;topSide++)
    {
        uint o=topBase+(topSide-1u)*3u;
        _Indices[ArenaIndexSlot(o+0u)]=ArenaVertex(vertexBase+sides);
        _Indices[ArenaIndexSlot(o+1u)]=ArenaVertex(vertexBase+sides+topSide+1u);
        _Indices[ArenaIndexSlot(o+2u)]=ArenaVertex(vertexBase+sides+topSide);
    }

    uint fringeVertex=vertexBase+12u, fringeIndex=indexBase+48u;
    float maxDrop=((word2>>8)&0xFFu)*(1.0/16.0);
    for(int sideFace=0;sideFace<6;sideFace++)
    {
        if((fringes&(1u<<sideFace))==0u) continue;
        int sideAxis=sideFace>>1;
        int sideSign=(sideFace&1)==0?-1:1;
        int direction=sideAxis==axisB?(sideSign>0?0:1):(sideSign>0?2:3);
        WriteDecorationFringe(centre,axisA,axisB,radiusA,radiusB,maxDrop,
            hash^((uint)sideFace*0x9E37u),direction,attributes,fringeVertex,fringeIndex);
        fringeVertex+=4u; fringeIndex+=6u;
    }
}

[numthreads(64, 1, 1)]
void CSWriteDecorations(uint3 id : SV_DispatchThreadID)
{
    int3 voxel; uint material,surface,coating,word1,word2;
    if(!LoadDecorationCell((int)id.x,voxel,material,surface,coating,word1,word2)) return;
    for(int face=0;face<6;face++)
    {
        int axis,sign; uint hash,fringes;
        if(!ClassifyDecorationFace(voxel,coating,word1,word2,face,axis,sign,hash,fringes)) continue;
        WriteDecorationFace(voxel,material,surface,word1,word2,axis,sign,hash,fringes);
    }
}

// ---------------------------------------------------------------------------
// 3. Write geometry into reserved space.
// ---------------------------------------------------------------------------

float3 DensityNormal(int3 g)
{
    int hi = _GridSize - 1;
    float x = _Density[GridIndex(clamp(g - int3(1, 0, 0), 0, hi))]
            - _Density[GridIndex(clamp(g + int3(1, 0, 0), 0, hi))];
    float y = _Density[GridIndex(clamp(g - int3(0, 1, 0), 0, hi))]
            - _Density[GridIndex(clamp(g + int3(0, 1, 0), 0, hi))];
    float z = _Density[GridIndex(clamp(g - int3(0, 0, 1), 0, hi))]
            - _Density[GridIndex(clamp(g + int3(0, 0, 1), 0, hi))];
    float3 n = float3(x, y, z);
    float len = length(n);
    return len > 1e-6 ? n / len : float3(0, 1, 0);
}

uint PackMaterial(uint material, uint surface)
{
    return (material & 0xFFu)
         | (((surface >> 16) & 0xFFu) << 8)
         | ((surface & 0xFFu) << 16)
         | (((surface >> 24) & 0xFFu) << 24);
}

[numthreads(64, 1, 1)]
void CSWriteCells(uint3 id : SV_DispatchThreadID)
{
    int cellIndex = (int)id.x;
    int axis = RegularCellAxis();
    int cellTotal = axis * axis * axis;
    if (cellIndex >= cellTotal) return;

    uint outputVertexCount = _CellVertexCounts[cellIndex];
    uint triangleCount = _CellTriangleCounts[cellIndex];
    if (outputVertexCount == 0u || triangleCount == 0u) return;
    uint indexCount = triangleCount * 3u;

    int3 cell = RegularCellFromIndex(cellIndex);

    uint caseCode = 0u;
    int selectedInsideCorner = -1;
    float density[8];
    uint material[8];
    uint surface[8];
    uint boundary[8];
    for (int i = 0; i < 8; i++)
    {
        int sample = GridIndex(cell + _Padding + CellCorner(i));
        density[i] = _Density[sample];
        material[i] = _SampleMaterial[sample];
        surface[i] = _SampleSurface[sample];
        boundary[i] = _SampleBoundary[sample];
        if (density[i] < 0.0) caseCode |= 1u << (uint)i;
        else if (selectedInsideCorner < 0) selectedInsideCorner = i;
    }
    if (caseCode == 0u || caseCode == 255u) return;
    if (!OwnsSelectedInsideSample(cell, selectedInsideCorner)) return;

    uint cellClass = _RegularCellClass[caseCode];
    uint sourceVertexCount = _RegularGeometryCounts[cellClass] >> 4;

    SurfaceVertex cellVertices[15];
    for (uint v = 0u; v < sourceVertexCount; v++)
    {
        uint edge = _RegularEdgeCodes[caseCode * 12u + v];
        int c0 = (int)((edge >> 4) & 0x0Fu);
        int c1 = (int)(edge & 0x0Fu);

        float d0 = density[c0];
        float d1 = density[c1];
        int3 o0 = CellCorner(c0);
        int3 o1 = CellCorner(c1);
        int3 delta = abs(o1 - o0);
        int edgeAxis = delta.x != 0 ? 0 : (delta.y != 0 ? 1 : 2);

        if ((BoundaryIsAuthored(boundary[c0]) && !BoundaryAppliesAlong(boundary[c0], edgeAxis))
         || (BoundaryIsAuthored(boundary[c1]) && !BoundaryAppliesAlong(boundary[c1], edgeAxis)))
        {
            d0 = IsSolidSample(material[c0]) ? 0.5 : -0.5;
            d1 = IsSolidSample(material[c1]) ? 0.5 : -0.5;
        }

        float t0 = abs(d1 - d0) > 1e-7 ? d1 / (d1 - d0) : 0.5;
        float t1 = 1.0 - t0;
        float3 local = ((float3)(cell + o0) * t0 + (float3)(cell + o1) * t1) * _SourceStep;

        SurfaceVertex vertex;
        vertex.position = ((float3)_ChunkOriginVoxel + local + 0.5) * _VoxelSize;
        vertex.normal = normalize(DensityNormal(cell + _Padding + o0) * t0
                                + DensityNormal(cell + _Padding + o1) * t1);

        int selected = d0 > d1 ? c0 : c1;
        uint chosenMaterial = material[selected];
        uint chosenSurface = surface[selected];
        if (!IsSolidSample(chosenMaterial))
        {
            for (int corner = 0; corner < 8; corner++)
            {
                if (!IsSolidSample(material[corner])) continue;
                chosenMaterial = material[corner];
                chosenSurface = surface[corner];
                break;
            }
        }
        vertex.material = PackMaterial(chosenMaterial, chosenSurface);
        vertex.active = 0x0000FF00u;
        cellVertices[v] = vertex;
    }

    uint vertexBase, indexBase;
    InterlockedAdd(_Counters[0], outputVertexCount, vertexBase);
    InterlockedAdd(_Counters[1], indexCount, indexBase);

    if ((int)(vertexBase + outputVertexCount) > _VertexCapacity) return;
    if ((int)(indexBase + indexCount) > _IndexCapacity) return;

    uint tableBase = cellClass * 15u;
    if (outputVertexCount == indexCount)
    {
        for (uint t = 0u; t < indexCount; t += 3u)
        {
            SurfaceVertex a = cellVertices[_RegularCellIndices[tableBase + t]];
            SurfaceVertex b = cellVertices[_RegularCellIndices[tableBase + t + 1u]];
            SurfaceVertex c = cellVertices[_RegularCellIndices[tableBase + t + 2u]];

            float3 face = normalize(cross(b.position - a.position, c.position - a.position));
            float3 expected = a.normal + b.normal + c.normal;
            if (dot(face, expected) < 0.0) face = -face;
            a.normal = face; b.normal = face; c.normal = face;

            _Vertices[VertexSlot(vertexBase + t)] = a;
            _Vertices[VertexSlot(vertexBase + t + 1u)] = b;
            _Vertices[VertexSlot(vertexBase + t + 2u)] = c;
        }
        for (uint i2 = 0u; i2 < indexCount; i2++)
            _Indices[ArenaIndexSlot(indexBase + i2)] = ArenaVertex(vertexBase + i2);
    }
    else
    {
        for (uint v2 = 0u; v2 < sourceVertexCount; v2++)
            _Vertices[VertexSlot(vertexBase + v2)] = cellVertices[v2];
        for (uint i3 = 0u; i3 < indexCount; i3++)
            _Indices[ArenaIndexSlot(indexBase + i3)] =
                ArenaVertex(vertexBase + _RegularCellIndices[tableBase + i3]);
    }
}

// Copy only completed geometry into its unpublished arena lease. The expensive extraction kernels
// write private scratch buffers, so rasterization never has to order against a long UAV write on
// the live arena. Indirect args are still published by the CPU only after this copy is queued.
[numthreads(64, 1, 1)]
void CSCopyVertices(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    if (index >= _CopyVertexCount) return;
    _CopyVerticesDestination[_CopyVertexDestinationBase + index] = _CopyVerticesSource[index];
}

[numthreads(64, 1, 1)]
void CSCopyIndices(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    if (index >= _CopyIndexCount) return;
    _CopyIndicesDestination[_CopyIndexDestinationBase + index] = _CopyIndicesSource[index];
}

// Publication is ordered after both copy dispatches on the compute queue. The CPU swaps the
// completed lease into visibility only after the following fence passes, so a draw can never
// observe args for geometry whose copy is still in flight.
[numthreads(1, 1, 1)]
void CSPublishArgs(uint3 id : SV_DispatchThreadID)
{
    _DrawArgs[_DrawArgsWordStart + 0] = (uint)_CopyIndexCount;
    _DrawArgs[_DrawArgsWordStart + 1] = 1u;
    _DrawArgs[_DrawArgsWordStart + 2] = 0u;
    _DrawArgs[_DrawArgsWordStart + 3] = 0u;
}

// Count dispatches retain their large sampled fields in separate private extractors. Copying the
// four-word result into a shared batch buffer lets one bounded transfer complete several chunk
// descriptors without moving any sampled field or geometry through the CPU.
[numthreads(1, 1, 1)]
void CSCopyCountersToBatch(uint3 id : SV_DispatchThreadID)
{
    _BatchCounters[_BatchCounterWordStart + 0] = _Counters[0];
    _BatchCounters[_BatchCounterWordStart + 1] = _Counters[1];
    _BatchCounters[_BatchCounterWordStart + 2] = _Counters[2];
    _BatchCounters[_BatchCounterWordStart + 3] = _Counters[3];
}

uint AlignBatchCount(uint value, uint alignment)
{
    return ((value + alignment - 1u) / alignment) * alignment;
}

// Header: total vertex capacity, total index capacity, live draw records, reserved.
// Record: unsupported, args ordinal, vertex count, index count, vertex prefix, index prefix,
// aligned vertex capacity, aligned index capacity.
[numthreads(1, 1, 1)]
void CSPrefixBatchCounts(uint3 id : SV_DispatchThreadID)
{
    uint vertexTotal = 0u;
    uint indexTotal = 0u;
    uint drawCount = 0u;
    for (int record = 0; record < _BatchRecordCount; record++)
    {
        int word = 4 + record * 8;
        uint unsupported = _BatchCounters[word + 0];
        uint vertexCount = _BatchCounters[word + 2];
        uint indexCount = _BatchCounters[word + 3];
        if (unsupported != 0u || vertexCount == 0u || indexCount == 0u)
        {
            _BatchCounters[word + 1] = 0xFFFFFFFFu;
            _BatchCounters[word + 4] = 0u;
            _BatchCounters[word + 5] = 0u;
            _BatchCounters[word + 6] = 0u;
            _BatchCounters[word + 7] = 0u;
            continue;
        }

        uint vertexCapacity = AlignBatchCount(vertexCount, (uint)_BatchVertexAlignment);
        uint indexCapacity = AlignBatchCount(indexCount, (uint)_BatchIndexAlignment);
        _BatchCounters[word + 1] = drawCount++;
        _BatchCounters[word + 4] = vertexTotal;
        _BatchCounters[word + 5] = indexTotal;
        _BatchCounters[word + 6] = vertexCapacity;
        _BatchCounters[word + 7] = indexCapacity;
        vertexTotal += vertexCapacity;
        indexTotal += indexCapacity;
    }
    _BatchCounters[0] = vertexTotal;
    _BatchCounters[1] = indexTotal;
    _BatchCounters[2] = drawCount;
    _BatchCounters[3] = 0u;
}

// ---------------------------------------------------------------------------
// 4. Transition cells.
// ---------------------------------------------------------------------------

StructuredBuffer<uint> _TransitionCellClass;
StructuredBuffer<uint> _TransitionGeometryCounts;
StructuredBuffer<uint> _TransitionCellIndices;
StructuredBuffer<uint> _TransitionVertexData;
int _TransitionVertexStride;
int _TransitionIndexStride;

RWStructuredBuffer<float> _FaceDensityWrite;
RWStructuredBuffer<uint> _FaceMaterialWrite;
RWStructuredBuffer<uint> _FaceSurfaceWrite;

StructuredBuffer<float> _FaceDensity;
StructuredBuffer<uint> _FaceMaterial;
StructuredBuffer<uint> _FaceSurface;

int _Face;
int _FaceSamplesPerAxis;

void FaceAxes(int face, out int3 uAxis, out int3 vAxis, out int3 wAxis)
{
    int axis = face >> 1;
    bool positive = (face & 1) != 0;
    if (axis == 0)
    {
        uAxis = int3(0, 1, 0); vAxis = int3(0, 0, 1);
        wAxis = int3(positive ? -1 : 1, 0, 0);
    }
    else if (axis == 1)
    {
        uAxis = int3(0, 0, 1); vAxis = int3(1, 0, 0);
        wAxis = int3(0, positive ? -1 : 1, 0);
    }
    else
    {
        uAxis = int3(1, 0, 0); vAxis = int3(0, 1, 0);
        wAxis = int3(0, 0, positive ? -1 : 1);
    }
}

int FaceIndex(int u, int v)
{
    int cu = clamp(u, 0, _FaceSamplesPerAxis - 1);
    int cv = clamp(v, 0, _FaceSamplesPerAxis - 1);
    return cu + _FaceSamplesPerAxis * cv;
}

[numthreads(64, 1, 1)]
void CSSampleFace(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    int total = _FaceSamplesPerAxis * _FaceSamplesPerAxis;
    if (index >= total) return;

    int3 uAxis, vAxis, wAxis;
    FaceAxes(_Face, uAxis, vAxis, wAxis);

    int axis = _Face >> 1;
    bool positive = (_Face & 1) != 0;
    int3 axisMask = int3(axis == 0 ? 1 : 0, axis == 1 ? 1 : 0, axis == 2 ? 1 : 0);
    int3 faceOrigin = _ChunkOriginVoxel
                    + (positive ? axisMask * (_CellsPerAxis * _SourceStep) : int3(0, 0, 0));

    int halfStep = max(1, _SourceStep / 2);
    int u = index % _FaceSamplesPerAxis;
    int v = index / _FaceSamplesPerAxis;
    int3 voxel = faceOrigin + uAxis * (u * halfStep) + vAxis * (v * halfStep);

    uint surface, boundary;
    uint material = ReadMaterial(voxel, surface, boundary);
    bool occupied = IsSolidSample(material);

    _FaceDensityWrite[index] = occupied ? 0.5 : -0.5;
    _FaceMaterialWrite[index] = occupied ? material : 0u;
    _FaceSurfaceWrite[index] = occupied ? ResolveSurface(material, surface) : 0u;
}

float3 TransitionSamplePosition(int sample, int cellU, int cellV,
                                int3 uAxis, int3 vAxis, int3 wAxis,
                                float3 facePlane, float slabDepth)
{
    int du, dv;
    bool coarse = sample >= 9;
    if (coarse)
    {
        int corner = sample - 9;
        du = (corner & 1) * 2;
        dv = ((corner >> 1) & 1) * 2;
    }
    else
    {
        du = sample % 3;
        dv = sample / 3;
    }

    float half = _SourceStep * 0.5;
    float3 onFace = facePlane
                  + (float3)uAxis * ((cellU * 2 + du) * half)
                  + (float3)vAxis * ((cellV * 2 + dv) * half);
    return coarse ? onFace + (float3)wAxis * slabDepth : onFace;
}

[numthreads(64, 1, 1)]
void CSTransitionCells(uint3 id : SV_DispatchThreadID)
{
    int cellIndex = (int)id.x;
    int cellTotal = _CellsPerAxis * _CellsPerAxis;
    if (cellIndex >= cellTotal) return;
    if (_TransitionCountOnly != 0 && _Counters[0] != 0u) return;

    int cellU = cellIndex % _CellsPerAxis;
    int cellV = cellIndex / _CellsPerAxis;

    int3 uAxis, vAxis, wAxis;
    FaceAxes(_Face, uAxis, vAxis, wAxis);
    bool positive = (_Face & 1) != 0;
    float3 facePlane = positive
        ? -(float3)wAxis * (_CellsPerAxis * _SourceStep)
        : float3(0, 0, 0);

    float densities[13];
    uint materials[13];
    uint surfaces[13];

    uint caseCode = 0u;
    for (int i = 0; i < 9; i++)
    {
        int index = FaceIndex(cellU * 2 + (i % 3), cellV * 2 + (i / 3));
        densities[i] = _FaceDensity[index];
        materials[i] = _FaceMaterial[index];
        surfaces[i] = _FaceSurface[index];
        if (densities[i] > 0.0) caseCode |= 1u << (uint)i;
    }

    int coarseDu[4] = { 0, 2, 0, 2 };
    int coarseDv[4] = { 0, 0, 2, 2 };
    for (int c = 0; c < 4; c++)
    {
        int index = FaceIndex(cellU * 2 + coarseDu[c], cellV * 2 + coarseDv[c]);
        densities[9 + c] = _FaceDensity[index];
        materials[9 + c] = _FaceMaterial[index];
        surfaces[9 + c] = _FaceSurface[index];
    }

    uint cellClass = _TransitionCellClass[caseCode];
    uint classIndex = cellClass & 0x7Fu;
    bool reversed = (cellClass & 0x80u) != 0u;

    uint counts = _TransitionGeometryCounts[classIndex];
    uint vertexCount = counts >> 4;
    uint triangleCount = counts & 0x0Fu;
    if (triangleCount == 0u || vertexCount == 0u) return;

    float slabDepth = _SourceStep;

    if (_TransitionCountOnly != 0)
    {
        uint ignored;
        InterlockedAdd(_Counters[2], vertexCount, ignored);
        InterlockedAdd(_Counters[3], triangleCount * 3u, ignored);
        return;
    }

    uint vertexBase, indexBase;
    InterlockedAdd(_Counters[0], vertexCount, vertexBase);
    InterlockedAdd(_Counters[1], triangleCount * 3u, indexBase);
    if ((int)(vertexBase + vertexCount) > _VertexCapacity) return;
    if ((int)(indexBase + triangleCount * 3u) > _IndexCapacity) return;

    float3 faceNormal = normalize(-(float3)wAxis);
    for (uint v2 = 0u; v2 < vertexCount; v2++)
    {
        uint descriptor = _TransitionVertexData[caseCode * (uint)_TransitionVertexStride + v2];
        int c0 = (int)((descriptor >> 4) & 0x0Fu);
        int c1 = (int)(descriptor & 0x0Fu);

        float d0 = densities[c0];
        float d1 = densities[c1];
        float t0 = abs(d1 - d0) > 1e-7 ? d1 / (d1 - d0) : 0.5;
        float t1 = 1.0 - t0;

        float3 p0 = TransitionSamplePosition(c0, cellU, cellV, uAxis, vAxis, wAxis,
                                             facePlane, slabDepth);
        float3 p1 = TransitionSamplePosition(c1, cellU, cellV, uAxis, vAxis, wAxis,
                                             facePlane, slabDepth);
        float3 local = p0 * t0 + p1 * t1;

        int selected = d0 > d1 ? c0 : c1;

        SurfaceVertex vertex;
        vertex.position = ((float3)_ChunkOriginVoxel + local + 0.5) * _VoxelSize;
        vertex.normal = faceNormal;
        vertex.material = PackMaterial(materials[selected], surfaces[selected]);
        vertex.active = 0x0000FF00u;
        _Vertices[VertexSlot(vertexBase + v2)] = vertex;
    }

    for (uint t = 0u; t < triangleCount; t++)
    {
        uint tableBase = classIndex * (uint)_TransitionIndexStride + t * 3u;
        uint a = _TransitionCellIndices[tableBase + 0u];
        uint b = _TransitionCellIndices[tableBase + 1u];
        uint c = _TransitionCellIndices[tableBase + 2u];
        if (a >= vertexCount || b >= vertexCount || c >= vertexCount) continue;

        _Indices[ArenaIndexSlot(indexBase + t * 3u + 0u)] = ArenaVertex(vertexBase + a);
        _Indices[ArenaIndexSlot(indexBase + t * 3u + 1u)] =
            ArenaVertex(vertexBase + (reversed ? c : b));
        _Indices[ArenaIndexSlot(indexBase + t * 3u + 2u)] =
            ArenaVertex(vertexBase + (reversed ? b : c));
    }
}

#pragma kernel CSCountWater
#pragma kernel CSWriteWater VOXEL_WATER_WRITE

StructuredBuffer<int4> _WaterBrickOrigins;
StructuredBuffer<uint> _WaterMaterials;
RWStructuredBuffer<uint> _BatchCounters;
uint _WaterBrickStart, _WaterBrickCount, _WaterMaterialMask;
float _WaterVoxelSize;
uint _VertexPageSize, _IndexPageSize, _MaxVertexPages, _MaxIndexPages;
StructuredBuffer<uint> _VertexPageTable, _IndexPageTable;
struct SurfaceVertex { float3 position; float3 normal; uint material; uint active; };
RWStructuredBuffer<SurfaceVertex> _Vertices;
RWStructuredBuffer<uint> _Indices;

uint ReadByte(uint index)
{
    uint word = _WaterMaterials[index >> 2u];
    uint b = index & 3u;
    if (b == 0u) return word & 255u;
    if (b == 1u) return (word >> 8u) & 255u;
    if (b == 2u) return (word >> 16u) & 255u;
    return (word >> 24u) & 255u;
}
uint Sample(uint brick, int3 p)
{
    int outside = -1, sign = 0;
    for (int axis = 0; axis < 3; axis++)
    {
        if (p[axis] >= 0 && p[axis] < 8) continue;
        if ((p[axis] != -1 && p[axis] != 8) || outside >= 0) return 0u;
        outside = axis; sign = p[axis] < 0 ? -1 : 1;
    }
    if (outside < 0) return ReadByte(brick * 896u + p.x + 8 * (p.y + 8 * p.z));
    int a = (outside + 1) % 3, b = (outside + 2) % 3;
    uint face = outside * 2 + (sign > 0 ? 1 : 0);
    return ReadByte(brick * 896u + 512u + face * 64u + p[a] + 8 * p[b]);
}
bool Water(uint material) { return material < 32u && (_WaterMaterialMask & (1u << material)) != 0u; }
int3 Axis(uint axis, int amount)
{
    if (axis == 0u) return int3(amount, 0, 0);
    if (axis == 1u) return int3(0, amount, 0);
    return int3(0, 0, amount);
}
uint Topology(uint brick, int3 cell, uint faceAxis)
{
    if (faceAxis == 1u) return 0u;
    uint flags = 0u;
    if (!Water(Sample(brick, cell + int3(0, 1, 0)))) flags |= 0x01000000u;
    if (!Water(Sample(brick, cell - int3(0, 1, 0)))) flags |= 0x02000000u;
    int3 tangent = Axis(faceAxis == 0u ? 2u : 0u, 1);
    if (!Water(Sample(brick, cell - tangent)) || !Water(Sample(brick, cell + tangent))) flags |= 0x04000000u;
    return flags;
}
uint VertexSlot(uint local)
{
    uint table = (_BatchCounters[15u] * 2u + _BatchCounters[18u]) * _MaxVertexPages + local / _VertexPageSize;
    return _VertexPageTable[table] * _VertexPageSize + local % _VertexPageSize;
}
uint IndexSlot(uint local)
{
    uint table = (_BatchCounters[15u] * 2u + _BatchCounters[18u]) * _MaxIndexPages + local / _IndexPageSize;
    return _IndexPageTable[table] * _IndexPageSize + local % _IndexPageSize;
}
void Quad(float3 p0, float3 p1, float3 p2, float3 p3, float3 normal, uint4 material, uint4 uv)
{
#ifdef VOXEL_WATER_WRITE
    uint vb, ib;
    InterlockedAdd(_BatchCounters[12u], 4u, vb);
    InterlockedAdd(_BatchCounters[13u], 6u, ib);
    if (_BatchCounters[6u] < 4u || vb > _BatchCounters[6u] - 4u
        || _BatchCounters[7u] < 6u || ib > _BatchCounters[7u] - 6u) return;
    for (uint c = 0u; c < 4u; c++)
    {
        SurfaceVertex v;
        v.position = c == 0u ? p0 : (c == 1u ? p1 : (c == 2u ? p2 : p3));
        v.normal = normal; v.material = material[c]; v.active = 0x0000FF00u | uv[c];
        _Vertices[VertexSlot(vb + c)] = v;
    }
    bool flip = dot(cross(p1 - p0, p2 - p0), normal) < 0.0f;
    _Indices[IndexSlot(ib)] = vb;
    _Indices[IndexSlot(ib + 1u)] = vb + (flip ? 2u : 1u);
    _Indices[IndexSlot(ib + 2u)] = vb + (flip ? 1u : 2u);
    _Indices[IndexSlot(ib + 3u)] = vb;
    _Indices[IndexSlot(ib + 4u)] = vb + (flip ? 3u : 2u);
    _Indices[IndexSlot(ib + 5u)] = vb + (flip ? 2u : 3u);
#else
    InterlockedAdd(_BatchCounters[6u], 4u);
    InterlockedAdd(_BatchCounters[7u], 6u);
#endif
}
void SpraySheet(float3 e0, float3 e1, float4 spans, float3 plume, float3 normal, uint material)
{
    float3 edge = e1 - e0;
    Quad(e0 + edge * spans.x, e0 + edge * spans.y,
        e0 + edge * spans.w + plume, e0 + edge * spans.z + plume,
        normal, material.xxxx, uint4(0u, 1u, 3u, 2u));
}
void Emit(uint brick, int3 cell, uint axis, int sign, uint width, uint height, uint material)
{
    uint a = (axis + 1u) % 3u, b = (axis + 2u) % 3u;
    int3 da = Axis(a, width), db = Axis(b, height);
    int3 origin = _WaterBrickOrigins[brick].xyz + cell + Axis(axis, sign > 0 ? 1 : 0);
    float3 p0 = (float3)origin * _WaterVoxelSize;
    float3 p1 = (float3)(origin + da) * _WaterVoxelSize;
    float3 p2 = (float3)(origin + da + db) * _WaterVoxelSize;
    float3 p3 = (float3)(origin + db) * _WaterVoxelSize;
    int3 ca = Axis(a, width - 1u), cb = Axis(b, height - 1u);
    uint4 flags = uint4(Topology(brick, cell, axis), Topology(brick, cell + ca, axis),
        Topology(brick, cell + ca + cb, axis), Topology(brick, cell + cb, axis));
    float3 normal = (float3)Axis(axis, sign);
    Quad(p0, p1, p2, p3, normal, material.xxxx | flags, 0u.xxxx);
    bool impact03 = (flags.x & flags.w & 0x02000000u) != 0u;
    bool impact01 = (flags.x & flags.y & 0x02000000u) != 0u;
    if (axis == 1u || !((a == 1u && impact03) || (b == 1u && impact01))) return;
    float3 end = a == 1u ? p3 : p1;
    uint spray = material | 0x0e000000u;
    SpraySheet(p0, end, float4(0.06, 0.94, 0.24, 0.76),
        normal * (_WaterVoxelSize * 5.5) + float3(0, _WaterVoxelSize * 2.2, 0), normal, spray);
    SpraySheet(p0, end, float4(0.16, 0.78, 0.34, 0.70),
        normal * (_WaterVoxelSize * 4.0) + float3(0, _WaterVoxelSize * 4.8, 0), normal, spray);
    SpraySheet(p0, end, float4(0.31, 0.91, 0.48, 0.79),
        normal * (_WaterVoxelSize * 2.5) + float3(0, _WaterVoxelSize * 6.0, 0), normal, spray);
}
void Faces(uint3 id)
{
    if (id.x >= 48u || id.y >= _WaterBrickCount) return;
#ifdef VOXEL_WATER_WRITE
    if (_BatchCounters[14u] != 0u) return;
#endif
    uint brick = _WaterBrickStart + id.y, axis = id.x / 16u;
    int sign = (id.x / 8u) % 2u == 0u ? -1 : 1;
    uint layer = id.x % 8u, a = (axis + 1u) % 3u, b = (axis + 2u) % 3u;
    uint mask[64];
    for (uint v = 0u; v < 8u; v++)
    for (uint u = 0u; u < 8u; u++)
    {
        int3 cell = Axis(axis, layer) + Axis(a, u) + Axis(b, v);
        uint m = Sample(brick, cell);
        mask[u + v * 8u] = Water(m) && Sample(brick, cell + Axis(axis, sign)) == 0u ? m : 0u;
    }
    for (uint y = 0u; y < 8u; y++)
    for (uint x = 0u; x < 8u; x++)
    {
        uint material = mask[x + y * 8u];
        if (material == 0u) continue;
        uint width = 1u, height = 1u;
        while (x + width < 8u && mask[x + width + y * 8u] == material) width++;
        bool extend = true;
        while (y + height < 8u && extend)
        {
            for (uint k = 0u; k < width; k++)
                if (mask[x + k + (y + height) * 8u] != material) { extend = false; break; }
            if (extend) height++;
        }
        for (uint dy = 0u; dy < height; dy++)
        for (uint dx = 0u; dx < width; dx++) mask[x + dx + (y + dy) * 8u] = 0u;
        Emit(brick, Axis(axis, layer) + Axis(a, x) + Axis(b, y), axis, sign, width, height, material);
    }
}
[numthreads(1, 1, 1)] void CSCountWater(uint3 id : SV_DispatchThreadID) { Faces(id); }
[numthreads(1, 1, 1)] void CSWriteWater(uint3 id : SV_DispatchThreadID) { Faces(id); }

{
  "schemaVersion": 1,
  "runSeconds": 22,
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 3,
    "minimumFrames": 6,
    "evidenceAfterSeconds": 2
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "ARCHITECTURE_FOUNDATION_VALIDATION start",
      "deterministic=true",
      "variants=4",
      "ARCHITECTURE_FOUNDATION_VALIDATION canonical",
      "ARCHITECTURE_FOUNDATION_VALIDATION interior walkable=true glass=true sdfBoundary=true",
      "ARCHITECTURE_FOUNDATION_VALIDATION complete",
      "productionPath=true"
    ],
    "forbiddenLogPatterns": [
      "ARCHITECTURE_FOUNDATION_VALIDATION failure:",
      "InvalidOperationException",
      "NullReferenceException",
      "MissingReferenceException"
    ]
  }
}

{
  "schemaVersion": 1,
  "runSeconds": 10,
  "capture": {
    "width": 1280,
    "height": 720,
    "intervalSeconds": 2,
    "minimumFrames": 4,
    "evidenceAfterSeconds": 1
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "PROGRESSION_PRESENTATION_VALIDATION ready: revision=1 visibleObjectives=1 tracked=objective:reach-gate",
      "PROGRESSION_PRESENTATION_VALIDATION reveal: revision=2 visibleObjectives=2 firstState=Completed",
      "PROGRESSION_PRESENTATION_VALIDATION rebuild-stable: revision=2 tracked=objective:open-gate"
    ],
    "forbiddenLogPatterns": [
      "NullReferenceException",
      "MissingReferenceException",
      "PROGRESSION_PRESENTATION_VALIDATION failure:"
    ]
  }
}

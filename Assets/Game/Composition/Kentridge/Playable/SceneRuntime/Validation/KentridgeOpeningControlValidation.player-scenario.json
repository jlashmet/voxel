{
  "schemaVersion": 1,
  "runSeconds": 120,
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 2,
    "minimumFrames": 8,
    "evidenceAfterSeconds": 10
  },
  "timeline": {
    "autoDialogue": 0.2
  },
  "playerArguments": [
    "-voxel-kentridge-opening-control-validation"
  ],
  "assertions": {
    "requiredLogPatterns": [
      "KENTRIDGE_OPENING_CONTROL milestone=released",
      "KENTRIDGE_OPENING_CONTROL PASS"
    ],
    "forbiddenLogPatterns": [
      "KENTRIDGE_OPENING_CONTROL FAIL",
      "SYSTEM24 failure:",
      "InvalidOperationException",
      "NullReferenceException",
      "MissingReferenceException",
      "AssertionException",
      "Shader error"
    ]
  }
}

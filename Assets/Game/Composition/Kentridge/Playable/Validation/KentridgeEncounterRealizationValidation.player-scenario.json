{
  "schemaVersion": 1,
  "runSeconds": 12,
  "capture": {
    "width": 640,
    "height": 360,
    "intervalSeconds": 3,
    "minimumFrames": 3,
    "evidenceAfterSeconds": 2
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "KENTRIDGE_ENCOUNTER_REALIZATION_VALIDATION PASS"
    ],

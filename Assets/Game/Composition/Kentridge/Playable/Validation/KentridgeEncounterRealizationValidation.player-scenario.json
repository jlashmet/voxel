{
  "schemaVersion": 1,
  "mode": "multiProcess",
  "runSeconds": 30,
  "processes": [
    {
      "role": "validation",
      "headless": true
    }
  ],
  "milestones": [
    {
      "role": "validation",
      "name": "encounter-realization-ready",
      "timeoutSeconds": 30,
      "fields": {
        "participants": 3
      }
    }
  ],
  "assertions": {
    "requiredLogPatterns": [
      "KENTRIDGE_ENCOUNTER_REALIZATION_VALIDATION PASS"
    ],
    "forbiddenLogPatterns": [
      "NullReferenceException",
      "MissingReferenceException",
      "InvalidOperationException",
      "FAIL"
    ]
  }
}

{
  "schemaVersion": 1,
  "runSeconds": 180,
  "gpuCutover": "required",
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 4,
    "minimumFrames": 8,
    "evidenceAfterSeconds": 10
  },
  "timeline": {
    "autoDialogue": 0.2
  },
  "assertions": {
    "requiredLogPatterns": [
      "KENTRIDGE_MACRO_MODULE_VALIDATION ready:",
      "MACROEVIDENCE application-new-game-requested",
      "MACROEVIDENCE traversal=CharacterMotor-local",
      "MACROEVIDENCE traversal=CharacterMotor-macro-road",
      "MACROEVIDENCE capture-ready target=macro-network-overview"
    ],
    "forbiddenLogPatterns": [
      "KENTRIDGE_MACRO_MODULE_VALIDATION FAILED:",
      "Macro evidence Application New Game rejected:",
      "InvalidOperationException",
      "NullReferenceException",
      "MissingReferenceException",
      "AssertionException",
      "Shader error"
    ]
  }
}

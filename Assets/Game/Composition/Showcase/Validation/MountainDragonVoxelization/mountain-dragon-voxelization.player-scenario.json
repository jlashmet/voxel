{
  "schemaVersion": 1,
  "runSeconds": 45,
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 3,
    "minimumFrames": 10
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "MOUNTAIN_DRAGON_MATTE_PRESENTATION material=6 roughness=1.0 smoothness=0.0",
      "MOUNTAIN_DRAGON_VALIDATION_COST",
      "MOUNTAIN_DRAGON_VALIDATION ready:",
      "MOUNTAIN_DRAGON_CAPTURE view=tail-closeup",
      "MOUNTAIN_DRAGON_DESTRUCTION_WORLD_TRUTH"
    ],
    "forbiddenLogPatterns": [
      "NullReferenceException",
      "MissingReferenceException",
      "Shader error"
    ]
  }
}

{
  "schemaVersion": 1,
  "runSeconds": 24,
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 6,
    "minimumFrames": 3,
    "evidenceAfterSeconds": 2
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "FEATURE_RESIDENCY_VALIDATION ready:",
      "FEATURE_RESIDENCY_COST "
    ],
    "forbiddenLogPatterns": [
      "FEATURE_RESIDENCY_VALIDATION FAILED:",
      "NullReferenceException",
      "MissingReferenceException",
      "Shader error"
    ]
  }
}

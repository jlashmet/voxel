{
  "schemaVersion": 1,
  "runSeconds": 45,
  "gpuCutover": "required",
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 8,
    "minimumFrames": 5,
    "evidenceAfterSeconds": 3
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "FEATURE_RESIDENCY ready:"
    ],
    "forbiddenLogPatterns": [
      "FEATURE_RESIDENCY failure:",
      "Exception",
      "Shader error",
      "GPU surface transaction rejected"
    ]
  }
}

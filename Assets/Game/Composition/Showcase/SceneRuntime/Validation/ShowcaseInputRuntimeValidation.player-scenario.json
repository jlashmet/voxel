{
  "schemaVersion": 1,
  "runSeconds": 12,
  "capture": {
    "width": 1280,
    "height": 720,
    "intervalSeconds": 3,
    "minimumFrames": 3,
    "evidenceAfterSeconds": 1
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "Showcase input validation ready:",
      "Showcase input validation PASS"
    ],
    "forbiddenLogPatterns": [
      "Showcase input validation FAIL:",
      "NullReferenceException",
      "MissingReferenceException",
      "Shader error"
    ]
  }
}

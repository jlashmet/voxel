{
  "schemaVersion": 1,
  "runSeconds": 10,
  "capture": {
    "width": 1280,
    "height": 720,
    "intervalSeconds": 2,
    "minimumFrames": 4,
    "evidenceAfterSeconds": 1
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "APPLICATION_VALIDATION ready: lifecycle=FrontEnd screen=MainMenu",
      "APPLICATION_VALIDATION new-game: lifecycle=InGame ready=True",
      "APPLICATION_VALIDATION continue: restore=save-continue lifecycle=InGame",
      "APPLICATION_VALIDATION multiplayer: host=hosted-party join=joined-party partySemantic=True",
      "APPLICATION_VALIDATION joined-sync-wait: lifecycle=FrontEnd composes=0",
      "APPLICATION_VALIDATION joined-start: lifecycle=InGame ready=True startCommands=0 prepares=1 productionOrchestration=True",
      "APPLICATION_VALIDATION joined-leave: lifecycle=FrontEnd noRestart=True",
      "APPLICATION_VALIDATION joined-rejoin: lifecycle=InGame composes=2 startCommands=0",
      "APPLICATION_VALIDATION menus-settings: context=Exploration persisted=True binding=Confirm",
      "APPLICATION_VALIDATION outcome-return: disposition=Success lifecycle=FrontEnd",
      "APPLICATION_FRONTEND_VIEW ready: bound=True lifecycle=FrontEnd",
      "APPLICATION_VALIDATION pending-admission: viewPumped=True memberAdopted=False composes=0",
      "APPLICATION_VALIDATION pending-cancel: staleIgnored=True leaves=0",
      "APPLICATION_VALIDATION pending-start: lifecycle=InGame composes=1 startCommands=0 viewPumped=True",
      "APPLICATION_VALIDATION pending-leave: lifecycle=FrontEnd leaves=1 disposedGraphs=1"
    ],
    "forbiddenLogPatterns": [
      "NullReferenceException",
      "MissingReferenceException",
      "APPLICATION_VALIDATION failure:"
    ]
  }
}

{
  "schemaVersion": 1,
  "runSeconds": 6,
  "capture": {
    "width": 1280,
    "height": 720,
    "intervalSeconds": 2,
    "minimumFrames": 2,
    "evidenceAfterSeconds": 1
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "CUTSCENE_VALIDATION dialogue-active=Hello, I'm Mr. Dragon."
    ],
    "forbiddenLogPatterns": [
      "NullReferenceException",
      "MissingReferenceException",
      "CUTSCENE_VALIDATION failure:"
    ]
  }
}

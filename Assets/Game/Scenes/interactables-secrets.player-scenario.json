{
  "schemaVersion": 1,
  "runSeconds": 30,
  "capture": {
    "width": 1600,
    "height": 900,
    "intervalSeconds": 10,
    "minimumFrames": 2
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "INTERACTABLES_SHOWCASE_READY objects="
    ],
    "forbiddenLogPatterns": [
      "NullReferenceException",
      "MissingReferenceException",
      "ArgumentException",
      "InvalidOperationException"
    ]
  }
}

{
  "schemaVersion": 1,
  "runSeconds": 36,
  "capture": {
    "width": 1280,
    "height": 720,
    "intervalSeconds": 6,
    "minimumFrames": 3,
    "evidenceAfterSeconds": 4
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "MACRO_PHYSICAL_WORLD_VIEW ready: target=settlement-road",
      "MACRO_PHYSICAL_WORLD_VIEW ready: target=lake-detour",
      "MACRO_PHYSICAL_WORLD_VIEW ready: target=ridge-pass",
      "MACRO_PHYSICAL_WORLD_COST ",
      "MACRO_PHYSICAL_WORLD_VALIDATION ready:"

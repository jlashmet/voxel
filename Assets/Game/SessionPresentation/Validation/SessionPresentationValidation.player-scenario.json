{
  "schemaVersion": 1,
  "runSeconds": 10,
  "capture": {
    "width": 1280,
    "height": 720,
    "intervalSeconds": 2,
    "minimumFrames": 4,
    "evidenceAfterSeconds": 1
  },
  "timeline": {},
  "assertions": {
    "requiredLogPatterns": [
      "SESSION_PRESENTATION_VALIDATION ready:",
      "SESSION_PRESENTATION_VALIDATION reconnect-stable:",
      "SESSION_PRESENTATION_VALIDATION ready-to-start: lifecycle=ReadyToStart canStart=True"
    ],
    "forbiddenLogPatterns": [
      "NullReferenceException",
      "MissingReferenceException",
      "SESSION_PRESENTATION_VALIDATION failure:"
    ]
  }
}
